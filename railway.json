{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @shopcycle/database exec prisma generate --schema=prisma/schema.prisma",
    "watchPatterns": ["apps/api/**", "packages/**", "themes/**", "package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", "railway.json"]
  },
  "deploy": {
    "startCommand": "node apps/api/server.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "multiRegionConfig": {
      "asia-southeast1-eqsg3a": { "numReplicas": 1 }
    }
  }
}
