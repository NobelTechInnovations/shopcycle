generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// Auth / Tenancy
// ─────────────────────────────────────────────

enum UserStatus {
  active
  invited
  disabled
}

model User {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  passwordHash    String
  status          UserStatus @default(active)
  /// Platform-level administrator — manages every store, the Plan catalog,
  /// and the App catalog from /admin/super-admin. Never set by any
  /// self-serve flow (registration, invites); seeded directly (see
  /// prisma/seed.js) or promoted by an existing super admin.
  isSuperAdmin    Boolean    @default(false)
  /// Embedded in every session token as `tv`; a token whose `tv` doesn't
  /// match is rejected. Bumping it (sign out everywhere, password change,
  /// disabling 2FA...) ends every existing session for this user at once —
  /// JWTs can't otherwise be revoked before they expire.
  tokenVersion    Int        @default(0)
  /// Authenticator-app (TOTP) secret, AES-GCM encrypted (lib/crypto.js).
  /// Set during 2FA setup; only enforced once totpEnabledAt is set, i.e.
  /// after the user has proved their app produces valid codes.
  totpSecret      String?
  totpEnabledAt   DateTime?
  /// Set when the owner clicks the link in the verification email sent at
  /// sign-up. Not required to use the admin — the dashboard just keeps
  /// asking until it's done, since password reset relies on the address.
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  storeUsers StoreUser[]
  authTokens AuthToken[]

  @@map("users")
}

/// One-time links emailed to a seller: password reset (30 minutes) and
/// email verification (3 days). Only a SHA-256 of the token is stored, so
/// a copy of the database can't be turned into working reset links; a
/// token is spent the moment it's used (usedAt).
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  /// "password_reset" | "email_verify"
  purpose   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/// Every email the platform sends — to sellers (password reset,
/// verification) and to shoppers on a store's behalf (order confirmation,
/// shipping, refunds, sign-in codes, abandoned checkout). The log is how a
/// merchant can see "did the customer get the shipping email?", and how
/// repeats are prevented (refType/refId). With no email provider
/// configured (local dev) nothing leaves the machine: the message is kept
/// here with its HTML so it can be read in the platform console.
model EmailLog {
  id                String   @id @default(cuid())
  storeId           String?
  to                String
  subject           String
  /// "order_confirmation", "password_reset", "shipping_update", ...
  template          String
  refType           String?
  refId             String?
  /// "sent" | "logged" (no provider — kept locally) | "failed"
  status            String
  provider          String
  providerMessageId String?
  error             String?  @db.Text
  /// Only kept for "logged" emails (local dev) — sent mail isn't stored.
  html              String?  @db.Text
  createdAt         DateTime @default(now())

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([refType, refId])
  @@index([createdAt])
  @@map("email_logs")
}

/// A 6-digit sign-in code emailed to a shopper (storefront accounts have
/// no passwords). Stored hashed; expires in 10 minutes; five wrong guesses
/// burn it. Scoped to one store — each store's shoppers are its own.
model ShopperOtp {
  id         String    @id @default(cuid())
  storeId    String
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, email, createdAt])
  @@map("shopper_otps")
}

// ─────────────────────────────────────────────
// Platform billing ledger — Phase 3
// ─────────────────────────────────────────────

/// Oyklane's commission on one order, at the store's plan rate when the
/// order was paid (1.5% Premium / 2.5% Starter). Billed one cycle in
/// arrears as a Razorpay add-on on the next renewal:
///   accrued   → recorded, not yet billed
///   scheduled → added to the next renewal (Razorpay add-on created)
///   paid      → included in a renewal charge (see invoiceId)
///   void      → order refunded/cancelled before it was billed
/// A refund after billing adds a negative `reversal` entry instead, which
/// nets off against the next cycle's fees.
model CommissionEntry {
  id              String   @id @default(cuid())
  storeId         String
  orderId         String
  orderNumber     Int
  /// "accrual" (+) or "reversal" (−) — at most one of each per order.
  kind            String   @default("accrual")
  orderTotal      Decimal  @db.Decimal(10, 2)
  percent         Decimal  @db.Decimal(4, 2)
  amount          Decimal  @db.Decimal(10, 2)
  status          String   @default("accrued")
  razorpayAddonId String?
  invoiceId       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  store   Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invoice PlatformInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([orderId, kind])
  @@index([storeId, status])
  @@map("commission_entries")
}

/// A GST tax invoice from Oyklane to a store, one per Razorpay renewal
/// charge. Amounts are GST-inclusive (plan prices include 18% GST); the
/// taxable value and tax are split out for the invoice. Seller and buyer
/// details are snapshotted at issue time, since a legal invoice must not
/// change if either side edits their address later.
model PlatformInvoice {
  id                String    @id @default(cuid())
  storeId           String
  /// Sequential across the platform, e.g. "OYK-000042".
  number            String    @unique
  /// Razorpay payment that settled this invoice — also what makes webhook
  /// retries idempotent (a second event for the same payment is a no-op).
  razorpayPaymentId String?   @unique
  periodStart       DateTime?
  periodEnd         DateTime?
  /// [{ description, amount }] — amounts GST-inclusive.
  lines             Json
  taxableValue      Decimal   @db.Decimal(10, 2)
  /// "cgst_sgst" (same state) or "igst" (inter-state).
  taxType           String
  taxAmount         Decimal   @db.Decimal(10, 2)
  total             Decimal   @db.Decimal(10, 2)
  status            String    @default("paid")
  seller            Json
  buyer             Json
  issuedAt          DateTime  @default(now())

  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  commissions CommissionEntry[]

  @@index([storeId, issuedAt])
  @@map("platform_invoices")
}

/// Razorpay webhook event ids already handled. Razorpay retries any event
/// it isn't sure was received, so each one is recorded and a repeat is
/// acknowledged without being processed twice.
model ProcessedWebhookEvent {
  id         String   @id
  event      String
  receivedAt DateTime @default(now())

  @@map("processed_webhook_events")
}

/// A shopper's cart — `data` is { items: [{ variantId, quantity }],
/// discountCode }; prices are never stored here, they're re-read from the
/// catalog on every view (see cart/service.js#hydrateCart). Lives in
/// Postgres rather than Redis so a cart survives API restarts and is shared
/// across every API process without extra infrastructure. `cartId` is a
/// random UUID held in the shopper's cookie; expired rows are swept lazily.
model CartSession {
  storeId   String
  cartId    String
  data      Json     @default("{}")
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  // Abandoned checkout (Phase 4): set once the shopper reaches checkout
  // and we know who they are (typed an email, or signed in). A cart with
  // these set and no order after an hour gets one reminder email
  // (reminderSentAt) with a link that restores it (recoveryToken). The row
  // is deleted when an order is placed, so what remains is abandoned.
  email             String?
  customerName      String?
  checkoutStartedAt DateTime?
  reminderSentAt    DateTime?
  recoveryToken     String?   @unique
  recoveredAt       DateTime?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, cartId])
  @@index([expiresAt])
  @@index([storeId, checkoutStartedAt])
  @@map("cart_sessions")
}

/// Append-only record of sensitive actions — every platform-console
/// mutation (suspending a store, editing plans/apps) and security events
/// (2FA changes, sign-out-everywhere). Deliberately no foreign keys: the
/// log must outlive the users and stores it describes, so actor and target
/// are stored as plain ids plus a denormalized email.
model AuditLog {
  id         String   @id @default(cuid())
  /// "platform" (a super-admin action) or "store" (a seller-side action).
  scope      String
  actorId    String?
  actorEmail String?
  /// Dotted verb, e.g. "store.suspend", "plan.update", "auth.2fa_enabled".
  action     String
  /// The store the action concerns, when there is one — lets a store's own
  /// history be pulled up in one query.
  storeId    String?
  targetType String?
  targetId   String?
  metadata   Json     @default("{}")
  ip         String?
  createdAt  DateTime @default(now())

  @@index([scope, createdAt])
  @@index([storeId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

enum StoreStatus {
  active
  suspended
}

/// A store's platform-billing lifecycle — deliberately separate from
/// StoreStatus (which is the super admin's manual suspend switch). Computed
/// lazily on each request from timestamps below (see
/// billing/access.js#computeAccessState) rather than a background job:
///  no_plan   → registered, no plan chosen yet (2-day grace, see
///              mandateDeadline), full access until that passes
///  trialing  → mandate authorized, free month running (trialEndsAt)
///  active    → real billing, last renewal succeeded
///  past_due  → a renewal charge failed (paymentFailedAt); still full
///              access for 7 days, then admin-only blocked, then (15
///              days) the storefront too — see access.js for the exact
///              day-by-day thresholds
///  cancelled → merchant or platform cancelled the subscription
enum SubscriptionStatus {
  no_plan
  trialing
  active
  past_due
  cancelled
}

model Store {
  id       String      @id @default(cuid())
  name     String
  handle   String      @unique
  /// A merchant's own domain (e.g. "shop.example.com"), resolved to this
  /// store by the storefront in addition to the always-available
  /// /store/:handle path — see apps/storefront middleware.js. Optional;
  /// most stores never set one and keep using the handle path.
  domain   String?     @unique
  currency String      @default("INR")
  timezone String      @default("Asia/Kolkata")
  status   StoreStatus @default(active)
  /// Misc. settings that don't warrant their own column (weight unit, order
  /// number prefix, low-stock threshold, ...) — General settings tab.
  settings Json        @default("{}")

  // Phase 7/9 — Multi-tenant SaaS billing. `planId` null means "no plan
  // chosen yet" — see SubscriptionStatus's doc comment for the full
  // lifecycle these fields drive together.
  planId                 String?
  subscriptionStatus     SubscriptionStatus @default(no_plan)
  /// Set once, at registration (provisionStore) — the deadline for
  /// choosing a plan and authorizing the mandate before admin access is
  /// blocked. Irrelevant once subscriptionStatus leaves no_plan.
  mandateDeadline        DateTime?
  /// Set when the mandate is authorized (subscriptionStatus → trialing) —
  /// the free month's end date.
  trialEndsAt            DateTime?
  /// Set by the Razorpay webhook the moment a renewal charge fails —
  /// the anchor the 7-day/15-day access thresholds count from. Cleared
  /// the next time a charge succeeds.
  paymentFailedAt        DateTime?
  /// Razorpay's own subscription id (sub_...) — created once, when the
  /// merchant first authorizes a plan's mandate; reused for every
  /// subsequent renewal, so this is what the webhook uses to find which
  /// Store a charge/failure event belongs to.
  razorpaySubscriptionId String?            @unique
  /// End of the billing period Razorpay last charged for (subscription
  /// `current_end`) — the moment a scheduled downgrade takes effect.
  currentPeriodEnd       DateTime?
  /// A downgrade scheduled for the end of the paid period (upgrades apply
  /// immediately, so only downgrades ever wait here). Cleared when applied
  /// or cancelled — see billing/plan-change.js.
  pendingPlanId          String?

  /// What goes on this store's GST invoices from Oyklane. All optional —
  /// without a GSTIN the invoice is a plain (B2C) tax invoice.
  billingName    String?
  gstin          String?
  billingAddress String? @db.Text
  /// Indian state of the billing address — decides CGST+SGST (same state
  /// as Oyklane) vs IGST (different state) on each invoice.
  billingState   String?

  /// Shown to shoppers in order emails (reply-to) and on invoices. Falls
  /// back to the owner's login email when empty.
  supportEmail String?
  supportPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan                 Plan?                 @relation(fields: [planId], references: [id], onDelete: SetNull)
  commissionEntries    CommissionEntry[]
  platformInvoices     PlatformInvoice[]
  storeUsers           StoreUser[]
  invitations          Invitation[]
  themes               Theme[]
  products             Product[]
  collections          Collection[]
  brands               Brand[]
  categories           Category[]
  customers            Customer[]
  orders               Order[]
  files                File[]
  pages                Page[]
  menus                Menu[]
  discounts            Discount[]
  shippingZones        ShippingZone[]
  taxRates             TaxRate[]
  visitorSessions      VisitorSession[]
  pageViews            PageView[]
  campaigns            Campaign[]
  installedApps        StoreApp[]
  cartSessions         CartSession[]
  metaConnection       MetaConnection?
  adCampaigns          AdCampaign[]
  whatsappMessages     WhatsappMessage[]
  emailLogs            EmailLog[]
  shopperOtps          ShopperOtp[]
  inventoryAdjustments InventoryAdjustment[]
  articles             Article[]
  giftCards            GiftCard[]

  @@map("stores")
}

/// A billing tier a store can be on. Seeded, not merchant-created — see
/// prisma/seed.js (currently exactly two: Starter and Premium). The
/// boolean/percent columns below are read by the admin UI to lock or show
/// features per plan (GST software, ads manager, staff limit, ...) — the
/// underlying features themselves may not all exist yet; a flag here is a
/// gate for when they do, not a claim that they're built.
model Plan {
  id           String   @id @default(cuid())
  name         String   @unique
  priceMonthly Decimal  @db.Decimal(10, 2)
  productLimit Int
  staffLimit   Int
  description  String?  @db.Text
  createdAt    DateTime @default(now())

  /// Platform's cut of every order this store processes, as a percent
  /// (e.g. 2.50 = 2.5%) — shown to the merchant, not yet deducted anywhere
  /// automatically (no payout/settlement system exists yet).
  commissionPercent      Decimal @default(0) @db.Decimal(4, 2)
  hasGstSoftware         Boolean @default(false)
  /// In-built ads manager (spend-according-to-budget) included in the
  /// plan price — off means it's available only as a separate paid add-on.
  hasAdsManagerIncluded  Boolean @default(false)
  hasMetaAds             Boolean @default(false)
  /// Paid apps (App.category, apps module) are free to install on this
  /// plan instead of billed separately.
  paidAppsIncluded       Boolean @default(false)
  premiumThemesIncluded  Boolean @default(false)
  hasWhatsappIntegration Boolean @default(false)
  hasSocialMediaManager  Boolean @default(false)
  prioritySupport        Boolean @default(false)
  /// Off = the storefront's cart/checkout is a fixed one-click flow; on =
  /// the merchant can customize it (theme editor cart/checkout sections
  /// become editable rather than locked to the default).
  cartCustomizable       Boolean @default(false)
  hasApiAccess           Boolean @default(false)
  /// CSV export of orders/customers/products (Content ▸ Export or similar).
  hasCsvExport           Boolean @default(false)
  /// The matching Plan created on Razorpay's side (razorpay.plans.create)
  /// — created once, lazily, the first time any store subscribes to this
  /// plan (see billing/service.js), then reused for every subscription.
  razorpayPlanId         String? @unique

  stores Store[]

  @@map("plans")
}

/// A pending team invite — a StoreUser row can't exist until the invitee
/// has a User account, so an invite by email needs its own row (and token)
/// to exist in the meantime. Accepting one creates the User (if new) plus
/// the StoreUser and deletes the invitation.
model Invitation {
  id        String    @id @default(cuid())
  storeId   String
  email     String
  role      StoreRole @default(staff)
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, email])
  @@index([storeId])
  @@map("invitations")
}

enum StoreRole {
  owner
  admin
  staff
}

model StoreUser {
  id        String    @id @default(cuid())
  storeId   String
  userId    String
  role      StoreRole @default(staff)
  createdAt DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@map("store_users")
}

// ─────────────────────────────────────────────
// Themes
// ─────────────────────────────────────────────

enum ThemeStatus {
  installed
  draft
}

model Theme {
  id           String      @id @default(cuid())
  storeId      String
  name         String
  handle       String
  description  String?     @db.Text
  version      String      @default("1.0.0")
  status       ThemeStatus @default(installed)
  isActive     Boolean     @default(false)
  previewImage String?
  /// Global theme settings (colors, typography, layout) — schema-driven, see config/settings_schema.json in the theme package
  settingsData Json        @default("{}")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  store Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  files ThemeFile[]

  @@index([storeId])
  @@map("themes")
}

model ThemeFile {
  id        String   @id @default(cuid())
  themeId   String
  /// e.g. "sections/hero.liquid", "templates/index.json", "assets/theme.css"
  path      String
  fileType  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  theme     Theme               @relation(fields: [themeId], references: [id], onDelete: Cascade)
  revisions ThemeFileRevision[]

  @@unique([themeId, path])
  @@map("theme_files")
}

/// A snapshot of a ThemeFile's content taken right before it's overwritten —
/// this is the entire "version history / rollback" mechanism for the code
/// editor. Denormalizes `path` so history is still legible even if the file
/// is later renamed or deleted out from under it.
model ThemeFileRevision {
  id          String   @id @default(cuid())
  themeFileId String
  path        String
  content     String   @db.Text
  createdAt   DateTime @default(now())

  themeFile ThemeFile @relation(fields: [themeFileId], references: [id], onDelete: Cascade)

  @@index([themeFileId, createdAt])
  @@map("theme_file_revisions")
}

// ─────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────

enum ProductStatus {
  active
  draft
  archived
}

model Product {
  id             String        @id @default(cuid())
  storeId        String
  title          String
  slug           String
  description    String?       @db.Text
  status         ProductStatus @default(draft)
  vendor         String?
  productType    String?
  brandId        String?
  categoryId     String?
  tags           String?       @db.Text
  seoTitle       String?
  seoDescription String?       @db.Text
  /// HSN code printed on GST invoices (e.g. "6109" for cotton T-shirts).
  hsnCode        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  brand              Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants           ProductVariant[]
  images             ProductImage[]
  collectionProducts CollectionProduct[]
  orderItems         OrderItem[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([brandId])
  @@index([categoryId])
  @@map("products")
}

model Brand {
  id        String   @id @default(cuid())
  storeId   String
  title     String
  slug      String
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("brands")
}

model Category {
  id        String   @id @default(cuid())
  storeId   String
  title     String
  slug      String
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("categories")
}

enum VariantStatus {
  active
  draft
}

model ProductVariant {
  id                String        @id @default(cuid())
  productId         String
  title             String        @default("Default")
  sku               String?
  price             Decimal       @db.Decimal(10, 2)
  comparePrice      Decimal?      @db.Decimal(10, 2)
  cost              Decimal?      @db.Decimal(10, 2)
  inventoryQuantity Int           @default(0)
  weight            Float?
  status            VariantStatus @default(active)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  product              Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  images               ProductImage[]
  orderItems           OrderItem[]
  inventoryAdjustments InventoryAdjustment[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  variantId String?
  url       String
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@map("product_images")
}

enum CollectionStatus {
  active
  draft
}

model Collection {
  id          String           @id @default(cuid())
  storeId     String
  title       String
  slug        String
  description String?          @db.Text
  image       String?
  status      CollectionStatus @default(draft)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  store    Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products CollectionProduct[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("collections")
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@map("collection_products")
}

// ─────────────────────────────────────────────
// Customers / Orders
// ─────────────────────────────────────────────

model Customer {
  id      String  @id @default(cuid())
  storeId String
  name    String
  email   String
  phone   String?

  // Default address — a single flat address rather than a separate
  // address-book model, matching the "customer should have an address"
  // scope here rather than building full multi-address management.
  address1 String?
  address2 String?
  city     String?
  province String?
  zip      String?
  country  String?

  acceptsEmailMarketing Boolean @default(false)
  acceptsSmsMarketing   Boolean @default(false)

  /// The same shopper's identity across every store on the platform,
  /// resolved by phone (falling back to email) whenever a Customer row is
  /// created or updated — see platform-customers/service.js#linkCustomer.
  /// Null only for rows written before this existed or with neither phone
  /// nor email resolvable at write time (shouldn't happen; email is
  /// required). A store's own admin never sees this id or anything through
  /// it — only super-admin's cross-store marketing view does.
  platformCustomerId String?

  /// Shopper accounts (Phase 4) — sign-in is by emailed code, so there's
  /// no password. tokenVersion works like User.tokenVersion: bumping it
  /// signs the shopper out on every device.
  emailVerifiedAt DateTime?
  lastSignInAt    DateTime?
  tokenVersion    Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  platformCustomer PlatformCustomer? @relation(fields: [platformCustomerId], references: [id], onDelete: SetNull)
  orders           Order[]
  sessions         VisitorSession[]
  whatsappMessages WhatsappMessage[]

  @@unique([storeId, email])
  @@index([storeId])
  @@index([platformCustomerId])
  @@map("customers")
}

enum PaymentStatus {
  pending
  paid
  partially_refunded
  refunded
}

enum FulfillmentStatus {
  unfulfilled
  partially_fulfilled
  fulfilled
  cancelled
}

model Order {
  id                String            @id @default(cuid())
  storeId           String
  orderNumber       Int
  customerId        String?
  paymentStatus     PaymentStatus     @default(pending)
  fulfillmentStatus FulfillmentStatus @default(unfulfilled)
  subtotal          Decimal           @db.Decimal(10, 2)
  discount          Decimal           @default(0) @db.Decimal(10, 2)
  discountCode      String?
  shipping          Decimal           @default(0) @db.Decimal(10, 2)
  tax               Decimal           @default(0) @db.Decimal(10, 2)
  total             Decimal           @db.Decimal(10, 2)
  currency          String            @default("INR")

  // Storefront checkout (Phase 6) — a snapshot taken at order time, not a
  // live reference to Customer.address*, so editing a customer's saved
  // address later never rewrites history for an order already placed.
  email            String?
  phone            String?
  shippingName     String?
  shippingAddress1 String?
  shippingAddress2 String?
  shippingCity     String?
  shippingProvince String?
  shippingZip      String?
  shippingCountry  String?

  /// "cod" (cash on delivery, settles instantly at order time — no gateway
  /// needed) or "razorpay" (online payment; only offered at checkout when
  /// RAZORPAY_KEY_ID/SECRET are configured, see checkout/service.js).
  paymentMethod     String  @default("cod")
  razorpayOrderId   String?
  razorpayPaymentId String?

  /// The storefront visitor session that placed this order, if one was
  /// tracked (see checkout/service.js) — this is the entire mechanism
  /// behind "which campaign drove this sale" in Analytics → Campaigns.
  sessionId String?

  /// Random, unguessable key for the shopper's order status page
  /// (/orders/<token>) linked from every order email — lets a guest check
  /// their order without an account. Minted on first use.
  statusToken        String?   @unique
  /// Sum of all refunds so far (see Refund).
  refundedAmount     Decimal   @default(0) @db.Decimal(10, 2)
  cancelledAt        DateTime?
  cancelReason       String?
  confirmationSentAt DateTime?
  /// Private note for the store's staff; never shown to the shopper.
  note               String?   @db.Text
  /// Part of `total` paid with a gift card (see GiftCard). The rest —
  /// total − giftCardAmount — is what the shopper pays by COD or online.
  giftCardAmount     Decimal   @default(0) @db.Decimal(10, 2)
  giftCardId         String?

  /// GST tax invoice to the shopper (Premium): a per-store serial issued
  /// once, when the order first ships or on request — see orders/invoice.js.
  invoiceSeq    Int?
  invoiceNumber String?
  invoicedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store        Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer     Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  session      VisitorSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  fulfillments Fulfillment[]
  refunds      Refund[]
  returns      ReturnRequest[]
  events       OrderEvent[]

  @@unique([storeId, orderNumber])
  @@unique([storeId, invoiceSeq])
  @@index([storeId])
  @@map("orders")
}

/// One shipment — some or all of an order's items handed to a courier.
/// An order ships in one or more fulfillments; the order's
/// fulfillmentStatus is derived from them (orders/fulfillment.js).
model Fulfillment {
  id             String    @id @default(cuid())
  orderId        String
  storeId        String
  /// "shipped" | "delivered" | "cancelled"
  status         String    @default("shipped")
  courier        String?
  trackingNumber String?
  trackingUrl    String?
  /// [{ orderItemId, quantity }]
  items          Json
  shippedAt      DateTime  @default(now())
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("fulfillments")
}

/// Money given back to a shopper, in full or in part. Online payments go
/// back through Razorpay (razorpayRefundId); cash-on-delivery refunds are
/// recorded as "manual" — the merchant pays the shopper back themselves.
model Refund {
  id               String   @id @default(cuid())
  orderId          String
  storeId          String
  amount           Decimal  @db.Decimal(10, 2)
  reason           String?
  /// [{ orderItemId, quantity }] — items refunded (restocked if `restocked`)
  items            Json     @default("[]")
  restocked        Boolean  @default(false)
  /// "razorpay" | "manual"
  method           String
  razorpayRefundId String?
  /// "processed" | "pending" | "failed"
  status           String
  createdAt        DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("refunds")
}

/// A return, requested by the shopper from their order status page or
/// opened by the merchant: requested → approved → received → closed, or
/// declined. Receiving it can restock the items and issue the refund.
model ReturnRequest {
  id           String   @id @default(cuid())
  orderId      String
  storeId      String
  status       String   @default("requested")
  /// [{ orderItemId, quantity }]
  items        Json
  reason       String?
  customerNote String?  @db.Text
  merchantNote String?  @db.Text
  /// "shopper" | "merchant"
  requestedBy  String   @default("shopper")
  refundId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([storeId, status])
  @@map("returns")
}

/// The order's timeline — every change, email and note, newest first on
/// the order page. Written alongside the change it describes.
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  /// "placed" | "paid" | "fulfilled" | "delivered" | "refunded" |
  /// "cancelled" | "email" | "note" | "return" | "invoice" | "status"
  kind      String
  message   String
  /// Who did it: a staff member's name, "Customer", or null for the system.
  actorName String?
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

/// Every change to a variant's stock and why — the history behind the
/// number. Sales, cancellations and restocking refunds write here
/// automatically; staff adjustments (received stock, damage, counts) come
/// from Products ▸ Inventory.
model InventoryAdjustment {
  id            String   @id @default(cuid())
  storeId       String
  variantId     String
  delta         Int
  quantityAfter Int
  /// "sold" | "received" | "correction" | "damaged" | "returned" |
  /// "order_cancelled" | "import"
  reason        String
  note          String?
  orderId       String?
  actorName     String?
  createdAt     DateTime @default(now())

  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([variantId, createdAt])
  @@map("inventory_adjustments")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  variantId String?
  title     String
  sku       String?
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

// ─────────────────────────────────────────────
// Media
// ─────────────────────────────────────────────

model File {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  url       String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("files")
}

// ─────────────────────────────────────────────
// Content (Pages / Navigation)
// ─────────────────────────────────────────────

enum PageStatus {
  active
  draft
}

model Page {
  id             String     @id @default(cuid())
  storeId        String
  title          String
  slug           String
  body           String?    @db.Text
  status         PageStatus @default(draft)
  seoTitle       String?
  seoDescription String?    @db.Text
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("pages")
}

/// A navigation menu, e.g. "main-menu" / "footer-menu" — the `handle`
/// matches what a section's `menu` setting references (see
/// themes/*/sections/header.liquid, footer.liquid), and resolves at render
/// time into the `linklists` context (see theme-engine/context.js).
model Menu {
  id        String   @id @default(cuid())
  storeId   String
  handle    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items MenuItem[]

  @@unique([storeId, handle])
  @@index([storeId])
  @@map("menus")
}

model MenuItem {
  id       String @id @default(cuid())
  menuId   String
  label    String
  url      String
  position Int    @default(0)

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId])
  @@map("menu_items")
}

// ─────────────────────────────────────────────
// Phase 5 — Discounts / Shipping / Taxes
// ─────────────────────────────────────────────

enum DiscountType {
  percentage
  fixed_amount
}

enum DiscountStatus {
  active
  disabled
}

model Discount {
  id          String         @id @default(cuid())
  storeId     String
  code        String
  type        DiscountType
  value       Decimal        @db.Decimal(10, 2)
  minSubtotal Decimal?       @db.Decimal(10, 2)
  usageLimit  Int?
  usageCount  Int            @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  status      DiscountStatus @default(active)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, code])
  @@index([storeId])
  @@map("discounts")
}

/// Deliberately simple: one flat set of rates per zone, matched by country,
/// rather than full carrier-calculated rates — real value (merchants can
/// price shipping) without pretending to be a full shipping-rate engine.
model ShippingZone {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  countries String   @db.Text // comma-separated ISO country codes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rates ShippingRate[]

  @@index([storeId])
  @@map("shipping_zones")
}

model ShippingRate {
  id        String   @id @default(cuid())
  zoneId    String
  name      String
  price     Decimal  @db.Decimal(10, 2)
  /// Subtotal at or above this makes the rate free — null means never free.
  freeAbove Decimal? @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
  @@map("shipping_rates")
}

/// One flat rate per region — same "real but simple" tradeoff as shipping;
/// no tax-jurisdiction-by-address resolution without a checkout address.
model TaxRate {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  country   String
  province  String?
  rate      Decimal  @db.Decimal(5, 2) // percentage, e.g. 18.00
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("tax_rates")
}

// ─────────────────────────────────────────────
// Phase 8 — Analytics
// ─────────────────────────────────────────────

enum DeviceType {
  desktop
  mobile
  tablet
  unknown
}

/// One browsing session — resets after 30 minutes of inactivity (see
/// analytics/service.js), same definition every analytics tool uses. UTM
/// and referrer are captured once, at session start (first-touch
/// attribution) — a shopper browsing five pages after clicking one ad
/// should still show as "from that ad," not "direct" by the last page.
model VisitorSession {
  id          String     @id @default(cuid())
  storeId     String
  customerId  String?
  country     String?
  deviceType  DeviceType @default(unknown)
  userAgent   String?    @db.Text
  referrer    String?    @db.Text
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  entryPath   String?
  firstSeenAt DateTime   @default(now())
  lastSeenAt  DateTime   @default(now())

  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  pageViews PageView[]
  orders    Order[]

  @@index([storeId])
  @@index([storeId, lastSeenAt])
  @@map("visitor_sessions")
}

model PageView {
  id           String   @id @default(cuid())
  storeId      String
  sessionId    String
  path         String
  templateName String?
  createdAt    DateTime @default(now())

  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  session VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([sessionId])
  @@map("page_views")
}

/// A merchant-created trackable link (Settings-adjacent, but merchandising
/// rather than config, hence its own top-level Campaigns area) — visiting
/// its generated URL stamps a new session with these UTM values, same as
/// any real ad click would.
model Campaign {
  id              String   @id @default(cuid())
  storeId         String
  name            String
  utmSource       String
  utmMedium       String
  utmCampaign     String
  utmTerm         String?
  utmContent      String?
  destinationPath String   @default("/")
  createdAt       DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("campaigns")
}

// ─────────────────────────────────────────────
// Apps (platform extensions — super-admin managed catalog,
// merchant-installed per store)
// ─────────────────────────────────────────────

/// One entry in the platform's app catalog — seeded/managed by a super
/// admin (see super-admin/apps), not merchant-created. `key` is the
/// stable identifier theme code and the render pipeline key off of (see
/// storefront/service.js's `apps` global); renaming `name` should never
/// break an already-installed store.
model App {
  id             String   @id @default(cuid())
  key            String   @unique
  name           String
  description    String?  @db.Text
  category       String   @default("other")
  /// One of the fixed keys in @shopcycle/ui's APP_ICONS (e.g. "megaphone",
  /// "puzzle") — rendered as a real icon component, never an emoji glyph.
  /// Was `iconEmoji` (a literal emoji character) before Phase 10.
  iconKey        String   @default("puzzle")
  /// The settings a merchant fills in on install, as a JSON Schema-ish
  /// shape the admin's install form renders generically: [{ id, label,
  /// type: "text" }]. Keeps adding a new app a data-only change most of
  /// the time, no new admin UI required.
  settingsSchema Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  installs StoreApp[]

  @@map("apps")
}

model StoreApp {
  id          String   @id @default(cuid())
  storeId     String
  appId       String
  /// Merchant-filled values matching the App's settingsSchema, e.g.
  /// { "measurementId": "G-XXXX" } for Google Analytics.
  settings    Json     @default("{}")
  installedAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  app   App   @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([storeId, appId])
  @@index([storeId])
  @@map("store_apps")
}

// ─────────────────────────────────────────────
// Meta integrations (Ads + WhatsApp) — Phase 10
// ─────────────────────────────────────────────

/// One Facebook Login for Business connection per store, shared by both
/// the "Meta Ads" and "WhatsApp" apps (StoreApp installs of key "meta-ads"
/// / "whatsapp") rather than each app doing its own OAuth — that mirrors
/// how Meta's own login actually works (one grant covers Pages, ad
/// accounts, and WhatsApp Business assets, scoped by whichever permissions
/// were requested) and means a merchant who's connected once for ads
/// doesn't have to connect Facebook again just to also turn on WhatsApp.
/// A store installing only one of the two apps still only sees that app's
/// own screens — this table isn't exposed directly, just used by both.
model MetaConnection {
  id      String @id @default(cuid())
  storeId String @unique

  /// A long-lived user access token (Graph API's 60-day token, refreshed
  /// on use — see integrations/meta/service.js#ensureFreshToken). Holding
  /// a system-user/permanent token would be better for a real production
  /// deployment but requires a Meta Business tech-provider setup; this is
  /// the integration every store can complete on their own, today.
  accessToken    String    @db.Text
  tokenExpiresAt DateTime?

  facebookUserId   String?
  facebookUserName String?

  /// Selected once, after connecting, from the ad accounts / pages /
  /// WhatsApp Business assets the granted token can see (see
  /// integrations/meta/service.js#listAssets). Null until the merchant
  /// actually picks one on the Connect screen.
  adAccountId      String?
  adAccountName    String?
  pageId           String?
  pageName         String?
  wabaId           String?
  wabaName         String?
  phoneNumberId    String?
  phoneNumberLabel String?

  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("meta_connections")
}

/// Our own record of a campaign created through the Meta Ads panel — Meta
/// itself remains the source of truth (see integrations/meta/service.js
/// #syncCampaignStatus), this just avoids a Graph API round trip to
/// render the campaigns list and lets us show it was made from here.
model AdCampaign {
  id             String   @id @default(cuid())
  storeId        String
  metaCampaignId String
  name           String
  objective      String
  status         String   @default("PAUSED")
  dailyBudget    Decimal? @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, metaCampaignId])
  @@index([storeId])
  @@map("ad_campaigns")
}

/// A log of every WhatsApp message sent (or received) through the
/// WhatsApp Cloud API for a store — both the audit trail a merchant sees
/// in the app's own screen and the record that makes a customer's WhatsApp
/// thread renderable at all (Meta's API itself keeps no history for us).
model WhatsappMessage {
  id         String  @id @default(cuid())
  storeId    String
  customerId String?
  toPhone    String

  direction String @default("outbound") // outbound | inbound
  /// "template" (Meta-approved, required to open a new 24h window) or
  /// "text" (free-form, only deliverable inside an already-open window).
  kind      String
  body      String @db.Text

  status            String  @default("sent") // sent | delivered | read | failed
  providerMessageId String?

  createdAt DateTime @default(now())

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([customerId])
  @@map("whatsapp_messages")
}

// ─────────────────────────────────────────────
// Cross-store customer identity — Phase 10
// ─────────────────────────────────────────────

/// The same shopper, unified across every store on the platform — the
/// piece that makes a customer created on xyz.com and one created on
/// abc.com (same platform, same person) recognizable as one identity for
/// platform-level marketing (super-admin only; a store's own admin only
/// ever queries its own Customer rows, never this table). Matched by
/// phone first — the more reliable shared key for Indian D2C checkout —
/// falling back to email when no phone is on file. See
/// platform-customers/service.js#linkCustomer for exactly how a Customer
/// row gets attached to one of these on create/update.
///
/// This is the identity layer only. It does not yet grant a shopper an
/// actual cross-store login/session (that needs OTP-based verification
/// and session issuance across arbitrary merchant domains — a separate
/// phase) — today it exists so super-admin can see and export a shopper's
/// full cross-store history for marketing, and so that future phase has
/// a stable id to hang a session off of instead of starting from scratch.
model PlatformCustomer {
  id    String  @id @default(cuid())
  phone String? @unique
  email String?
  name  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers Customer[]

  @@index([email])
  @@map("platform_customers")
}

// ─────────────────────────────────────────────
// Growth (Phase 6) — blog and gift cards
// ─────────────────────────────────────────────

/// A blog post on the storefront (/blog, /blog/<slug>). One blog per
/// store; `body` is the merchant's HTML (or plain text with line breaks).
model Article {
  id             String    @id @default(cuid())
  storeId        String
  title          String
  slug           String
  excerpt        String?   @db.Text
  body           String?   @db.Text
  image          String?
  imageAlt       String?
  author         String?
  /// Comma-separated, e.g. "guides, skincare".
  tags           String?
  /// "draft" | "published"
  status         String    @default("draft")
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@index([storeId, status, publishedAt])
  @@map("articles")
}

/// A store gift card. Its code is shown in full once — when issued (and
/// in the recipient's email) — and stored only as a hash plus the last 4
/// characters, so a database copy can't be spent. The balance moves only
/// through GiftCardTransaction rows.
model GiftCard {
  id             String    @id @default(cuid())
  storeId        String
  codeHash       String    @unique
  last4          String
  initialValue   Decimal   @db.Decimal(10, 2)
  balance        Decimal   @db.Decimal(10, 2)
  currency       String    @default("INR")
  /// "active" | "disabled"
  status         String    @default("active")
  expiresAt      DateTime?
  recipientName  String?
  recipientEmail String?
  note           String?   @db.Text
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  store        Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  transactions GiftCardTransaction[]

  @@index([storeId, createdAt])
  @@map("gift_cards")
}

/// Every change to a gift card's balance: issued (+), redeemed on an order
/// (−), refunded back from an order (+), or adjusted by staff (±).
model GiftCardTransaction {
  id         String   @id @default(cuid())
  giftCardId String
  orderId    String?
  amount     Decimal  @db.Decimal(10, 2)
  /// "issued" | "redeemed" | "refunded" | "adjusted"
  kind       String
  note       String?
  actorName  String?
  createdAt  DateTime @default(now())

  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  @@index([giftCardId, createdAt])
  @@index([orderId])
  @@map("gift_card_transactions")
}
