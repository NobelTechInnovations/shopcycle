{% comment %}
  Product card. Expects `product` (serialized); optional `eager` for the
  first row. Quick add posts the product straight to the cart when it has
  a single variant; otherwise it links to the product to pick options.
{% endcomment %}
{% assign pv = product.price_variant | default: product.variants.first %}
<article class="pcard">
  <a class="pcard__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {% if product.images.size > 0 %}
      <img class="pcard__img" src="{{ product.images[0].url }}" alt="" {% unless eager %}loading="lazy"{% endunless %} width="800" height="1000">
      {% if settings.card_hover_image and product.images.size > 1 %}
        <img class="pcard__img pcard__img--hover" src="{{ product.images[1].url }}" alt="" loading="lazy" width="800" height="1000">
      {% endif %}
    {% else %}
      {{ 'image' | placeholder_svg: 'pcard__ph' }}
    {% endif %}
    <span class="pcard__badges">
      {% unless product.available %}
        <span class="tag tag--muted">Sold out</span>
      {% else %}
        {% if product.on_sale %}<span class="tag tag--accent">−{{ product.discount_percent }}%</span>{% endif %}
      {% endunless %}
    </span>
  </a>
  {% if settings.card_quick_add and product.available %}
    {% if product.variants.size == 1 %}
      <form class="pcard__quick" method="post" action="{{ routes.cart_add_url }}" data-product-title="{{ product.title | escape }}">
        <input type="hidden" name="variantId" value="{{ pv.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="pcard__quick-btn" aria-label="Add {{ product.title | escape }} to cart">{% render 'snippets/icon', icon: 'plus', class: 'icon icon--sm' %}<span>Quick add</span></button>
      </form>
    {% else %}
      {% comment %} Opens a size/colour picker in the cart drawer (the product page without JS). {% endcomment %}
      <div class="pcard__quick"><a class="pcard__quick-btn" href="{{ product.url }}" data-oy-quick="{{ product.handle }}" aria-label="Quick add {{ product.title | escape }}">{% render 'snippets/icon', icon: 'plus', class: 'icon icon--sm' %}<span>Quick add</span></a></div>
    {% endif %}
  {% endif %}
  <div class="pcard__body">
    {% if settings.card_show_brand and product.brand %}<span class="pcard__brand">{{ product.brand }}</span>{% endif %}
    <h3 class="pcard__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {% if show_card_ratings and product.rating.count > 0 %}
      <span class="card-rating" aria-label="Rated {{ product.rating.average }} out of 5 from {{ product.rating.count }} reviews"><span class="stars" style="--stars: {{ product.rating.average | times: 20 }}%"></span>({{ product.rating.count }})</span>
    {% endif %}
    <p class="price">
      {% if product.rental %}
        <span class="price__now">{% if product.rental.has_tiers %}<span class="price__from">From</span> {{ product.rental.from_price | money }}{% else %}{{ product.rental.price_per_day | money }}{% endif %}</span><span class="price__from"> / day</span>
      {% else %}
      {% if product.price_varies %}<span class="price__from">From</span>{% endif %}
      {% if pv.comparePrice and pv.comparePrice > pv.price %}
        <span class="price__now price__now--sale">{{ pv.price | money }}</span>
        <s class="price__was">{{ pv.comparePrice | money }}</s>
      {% else %}
        <span class="price__now">{{ pv.price | money }}</span>
      {% endif %}
      {% endif %}
    </p>
  </div>
</article>
