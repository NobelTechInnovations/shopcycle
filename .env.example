# --- Database (Postgres / Supabase) ---
# Local Postgres: DATABASE_URL and DIRECT_URL can be the same value.
# Supabase: DATABASE_URL is the pooled connection (port 6543, pgbouncer=true),
# DIRECT_URL is the direct connection (port 5432) that Prisma migrate needs.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopcycle"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/shopcycle"

# --- Redis ---
REDIS_URL="redis://localhost:6380"

# --- Auth ---
JWT_SECRET="change-me-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="shopcycle_session"
# Production: ".oyklane.com" so every subdomain (store., superadmin., api.)
# shares the session cookie. Leave unset in local dev.
COOKIE_DOMAIN=""
# 64 hex chars — encrypts stored third-party secrets (Meta access tokens,
# 2FA secrets). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never change it once set in production: existing encrypted values become
# unreadable.
DATA_ENCRYPTION_KEY=""

# --- API ---
API_PORT=4100
API_HOST="0.0.0.0"
ADMIN_ORIGIN="http://localhost:3000"
STOREFRONT_ORIGIN="http://localhost:3002"
API_PUBLIC_URL="http://localhost:4100"
SUPER_ADMIN_ORIGIN="http://localhost:3003"
# "true" when the API runs behind a proxy (Hostinger LiteSpeed, Vercel, a
# load balancer), so rate limits see real visitor IPs. Leave "false" when
# the API is reachable directly — then X-Forwarded-For can be forged.
TRUST_PROXY="false"

# --- Payments (optional — Cash on Delivery works without these; set both
# to also offer online payment at checkout via Razorpay) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Platform billing subscriptions — the webhook secret Razorpay gives you
# when registering the webhook URL (Settings > Webhooks).
RAZORPAY_WEBHOOK_SECRET=""
# Local test mode for plan billing: with no Razorpay keys above, choosing a
# plan starts the free trial without any payment. Ignored once keys are set.
# NEVER set this in production (the API refuses to start if you do).
BILLING_SANDBOX="false"

# --- Email (order emails, sign-in codes, password reset) ---
# Any SMTP provider works: Resend (smtp.resend.com, user "resend", pass =
# API key), Brevo (smtp-relay.brevo.com), Amazon SES, Zoho, or Gmail with
# an app password. Leave SMTP_HOST empty in development: nothing is sent,
# and every email is kept in the platform console under Emails instead.
# EMAIL_FROM must be an address on a domain you've verified with the
# provider (SPF/DKIM), or mail will land in spam.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
EMAIL_FROM="Oyklane <no-reply@oyklane.com>"
# Or send through an HTTP API instead of SMTP (works where SMTP ports are
# blocked). EMAIL_PROVIDER: smtp | zeptomail | brevo | log (unset = smtp if
# SMTP_HOST is set). Zoho Mail is SMTP only: smtp.zoho.in, 465, SECURE=true.
EMAIL_PROVIDER=""
# Zoho CPaaS (ZeptoMail) ▸ agent ▸ SMTP/API ▸ API key ("Zoho-enczapikey …";
# the prefix is optional). Hosts that block SMTP (Railway below Pro) need this.
ZEPTOMAIL_TOKEN=""
ZEPTOMAIL_API_URL="https://cpaas.zoho.in/v1.1/email"
BREVO_API_KEY=""

# --- Image storage (uploads) ---
# With ImageKit (or Cloudinary) set, the browser uploads images straight to
# the CDN with a short-lived signature from the API — the files never pass
# through or live in the API/database. Unset: images stay in the database.
# MEDIA_STORAGE: imagekit | cloudinary | database (unset = whichever is set).
MEDIA_STORAGE=""
IMAGEKIT_PUBLIC_KEY="public_Q7PiJA3tv6D5pruC9Eq9ME+tdOo="
IMAGEKIT_PRIVATE_KEY="private_NsvNmYZNPd9/8z+pyDcmh0Gw27Y="
# Dashboard ▸ Developer options ▸ URL endpoint, e.g. https://ik.imagekit.io/oyklane
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/swe2tq7s1/"
IMAGEKIT_FOLDER="/stores"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- SMS / WhatsApp one-time codes (Phone Login app) ---
# SMS_PROVIDER: twilio | msg91 | log. WHATSAPP_PROVIDER: zoho | twilio | meta | log.
# With neither set, codes are only kept in the message log (development).
SMS_PROVIDER=""
WHATSAPP_PROVIDER=""
# Zoho CPaaS WhatsApp: the same agent API key as ZEPTOMAIL_TOKEN (either name
# works), the agent's WhatsApp number, an approved template's key, and the
# template placeholder that holds the code.
ZOHO_CPAAS_TOKEN="Zoho-enczapikey PHtE6r1bQ+++iGJ6pBlT5qLqE8elPYknrL9lLwNOsYoWD/ICF00BqIoqkTbl/RwiVfFHF6bPwN8+tOie5+qCc2/oZjpMVGqyqK3sx/VYSPOZsbq6x00fuFoSf0TVVYbse9Ru1SfVvN2X"
ZOHO_WHATSAPP_FROM="+15554330409"
ZOHO_WHATSAPP_TEMPLATE_KEY="df864bf0-ba4b-11f1-ae90-ae9c7e0b6a9f"
ZOHO_WHATSAPP_MERGE_KEY="code"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# SMS sender: a Messaging Service SID (preferred) or a Twilio number.
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_SMS_FROM=""
# WhatsApp sender, e.g. +14155238886, and an approved content template whose
# {{1}} is the code (needed outside a 24-hour conversation).
TWILIO_WHATSAPP_FROM=""
TWILIO_WHATSAPP_CONTENT_SID=""
# MSG91 (India): a DLT-approved OTP flow/template and its code variable name.
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""
MSG91_OTP_VAR="otp"
# WhatsApp Cloud API (Meta): system-user token, the number's phone_number_id,
# and an approved "authentication" template (with a copy-code button).
META_WHATSAPP_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_OTP_TEMPLATE=""
META_WHATSAPP_OTP_LANGUAGE="en"
META_WHATSAPP_OTP_BUTTON="true"
# SMS-pumping guard: codes only go to these country codes, and at most this
# many per store per day.
PHONE_LOGIN_COUNTRIES="91"
PHONE_LOGIN_DAILY_LIMIT="500"

# --- "Continue with Google" (sellers and shoppers) ---
# Google Cloud ▸ APIs & Services ▸ Credentials ▸ OAuth client (Web). Add both
# redirect URIs: <API_PUBLIC_URL>/api/auth/google/callback and
# <API_PUBLIC_URL>/api/shopper/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Abandoned-checkout reminder delay, and how often background jobs run.
ABANDONED_CHECKOUT_DELAY_MINUTES="60"
JOBS_INTERVAL_SECONDS="300"

# --- Oyklane's seller details on GST invoices to merchants ---
# PLATFORM_STATE decides CGST+SGST (merchant in the same state) vs IGST.
# Leave PLATFORM_GSTIN empty until registered; invoices say so.
PLATFORM_LEGAL_NAME="Oyklane"
PLATFORM_GSTIN=""
PLATFORM_ADDRESS=""
PLATFORM_STATE="Maharashtra"
# SAC code for your service on invoices — confirm with your CA.
PLATFORM_SAC=""

# --- Meta (Facebook) Login for Business — optional; backs both the
# "Meta Ads" and "WhatsApp" apps. Create one app at
# developers.facebook.com/apps and add META_OAUTH_REDIRECT_URI to its
# Valid OAuth Redirect URIs. ---
META_APP_ID=""
META_APP_SECRET=""
META_OAUTH_REDIRECT_URI="http://localhost:3000/admin/apps/meta/callback"
META_GRAPH_API_VERSION="v21.0"

# --- Instagram Feed app — optional. A Meta app with the "Instagram API
# with Instagram login" product (permission instagram_business_basic);
# add <ADMIN_ORIGIN>/admin/apps/instagram as its redirect URI. Without it
# sellers paste an access token instead. ---
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

# --- Google Reviews app — a Google Cloud API key with "Places API (New)". ---
GOOGLE_PLACES_API_KEY=""

# Local dev shares production's database: set to 1 only to add the newest
# catalog apps (Instagram Feed, Google Reviews) from a local start.
SEED_PREVIEW_APPS=""

# --- Admin (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:4100"

# --- Storefront (Next.js) ---
STOREFRONT_PORT=3002
API_INTERNAL_URL="http://localhost:4100"
