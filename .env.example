# --- Database (Postgres / Supabase) ---
# Local Postgres: DATABASE_URL and DIRECT_URL can be the same value.
# Supabase: DATABASE_URL is the pooled connection (port 6543, pgbouncer=true),
# DIRECT_URL is the direct connection (port 5432) that Prisma migrate needs.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopcycle"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/shopcycle"

# --- Redis ---
REDIS_URL="redis://localhost:6380"

# --- Auth ---
JWT_SECRET="change-me-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="shopcycle_session"
# Production: ".oyklane.com" so every subdomain (store., superadmin., api.)
# shares the session cookie. Leave unset in local dev.
COOKIE_DOMAIN=""
# 64 hex chars — encrypts stored third-party secrets (Meta access tokens,
# 2FA secrets). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never change it once set in production: existing encrypted values become
# unreadable.
DATA_ENCRYPTION_KEY=""

# --- API ---
API_PORT=4100
API_HOST="0.0.0.0"
ADMIN_ORIGIN="http://localhost:3000"
STOREFRONT_ORIGIN="http://localhost:3002"
API_PUBLIC_URL="http://localhost:4100"
SUPER_ADMIN_ORIGIN="http://localhost:3003"
# "true" when the API runs behind a proxy (Hostinger LiteSpeed, Vercel, a
# load balancer), so rate limits see real visitor IPs. Leave "false" when
# the API is reachable directly — then X-Forwarded-For can be forged.
TRUST_PROXY="false"

# --- Payments (optional — Cash on Delivery works without these; set both
# to also offer online payment at checkout via Razorpay) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Platform billing subscriptions — the webhook secret Razorpay gives you
# when registering the webhook URL (Settings > Webhooks).
RAZORPAY_WEBHOOK_SECRET=""
# Local test mode for plan billing: with no Razorpay keys above, choosing a
# plan starts the free trial without any payment. Ignored once keys are set.
# NEVER set this in production (the API refuses to start if you do).
BILLING_SANDBOX="false"

# --- Email (order emails, sign-in codes, password reset) ---
# Any SMTP provider works: Resend (smtp.resend.com, user "resend", pass =
# API key), Brevo (smtp-relay.brevo.com), Amazon SES, Zoho, or Gmail with
# an app password. Leave SMTP_HOST empty in development: nothing is sent,
# and every email is kept in the platform console under Emails instead.
# EMAIL_FROM must be an address on a domain you've verified with the
# provider (SPF/DKIM), or mail will land in spam.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
EMAIL_FROM="Oyklane <no-reply@oyklane.com>"
# Abandoned-checkout reminder delay, and how often background jobs run.
ABANDONED_CHECKOUT_DELAY_MINUTES="60"
JOBS_INTERVAL_SECONDS="300"

# --- Oyklane's seller details on GST invoices to merchants ---
# PLATFORM_STATE decides CGST+SGST (merchant in the same state) vs IGST.
# Leave PLATFORM_GSTIN empty until registered; invoices say so.
PLATFORM_LEGAL_NAME="Oyklane"
PLATFORM_GSTIN=""
PLATFORM_ADDRESS=""
PLATFORM_STATE="Maharashtra"
# SAC code for your service on invoices — confirm with your CA.
PLATFORM_SAC=""

# --- Meta (Facebook) Login for Business — optional; backs both the
# "Meta Ads" and "WhatsApp" apps. Create one app at
# developers.facebook.com/apps and add META_OAUTH_REDIRECT_URI to its
# Valid OAuth Redirect URIs. ---
META_APP_ID=""
META_APP_SECRET=""
META_OAUTH_REDIRECT_URI="http://localhost:3000/admin/apps/meta/callback"
META_GRAPH_API_VERSION="v21.0"

# --- Admin (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:4100"

# --- Storefront (Next.js) ---
STOREFRONT_PORT=3002
API_INTERNAL_URL="http://localhost:4100"
