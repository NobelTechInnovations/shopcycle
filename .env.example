# --- Database ---
DATABASE_URL="mysql://shopcycle:shopcycle@localhost:3306/shopcycle"

# --- Redis ---
REDIS_URL="redis://localhost:6380"

# --- Auth ---
JWT_SECRET="change-me-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="shopcycle_session"

# --- API ---
API_PORT=4100
API_HOST="0.0.0.0"
ADMIN_ORIGIN="http://localhost:3000"
STOREFRONT_ORIGIN="http://localhost:3002"
API_PUBLIC_URL="http://localhost:4100"

# --- Payments (optional — Cash on Delivery works without these; set both
# to also offer online payment at checkout via Razorpay) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Platform billing subscriptions — the webhook secret Razorpay gives you
# when registering the webhook URL (Settings > Webhooks).
RAZORPAY_WEBHOOK_SECRET=""

# --- Meta (Facebook) Login for Business — optional; backs both the
# "Meta Ads" and "WhatsApp" apps. Create one app at
# developers.facebook.com/apps and add META_OAUTH_REDIRECT_URI to its
# Valid OAuth Redirect URIs. ---
META_APP_ID=""
META_APP_SECRET=""
META_OAUTH_REDIRECT_URI="http://localhost:3000/admin/apps/meta/callback"
META_GRAPH_API_VERSION="v21.0"

# --- Admin (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:4100"

# --- Storefront (Next.js) ---
STOREFRONT_PORT=3002
API_INTERNAL_URL="http://localhost:4100"
