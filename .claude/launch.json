{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "www",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@shopcycle/www",
        "dev"
      ],
      "port": 3004
    },
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@shopcycle/admin",
        "exec",
        "next",
        "dev",
        "--port",
        "3010"
      ],
      "port": 3010
    }
  ]
}