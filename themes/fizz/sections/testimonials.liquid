{% comment %} Customer quotes in a swipeable row, with star ratings. {% endcomment %}
<section class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="container">
    <div class="quotes-head">
      {% render 'snippets/section-head', eyebrow: section.settings.eyebrow, title: section.settings.heading, align: 'left' %}
      <div class="slider-nav" data-slider-nav>
        <button type="button" class="icon-btn icon-btn--ring" data-slide="-1" aria-label="Previous">{% render 'snippets/icon', icon: 'chevron-left' %}</button>
        <button type="button" class="icon-btn icon-btn--ring" data-slide="1" aria-label="Next">{% render 'snippets/icon', icon: 'chevron-right' %}</button>
      </div>
    </div>
    <ul class="quotes" data-slider>
      {% for block in section.blocks %}
        <li class="quote">
          <span class="quote__stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">
            {% for i in (1..5) %}<span class="{% if i <= block.settings.rating %}is-on{% endif %}">{% render 'snippets/icon', icon: 'star', class: 'icon icon--sm' %}</span>{% endfor %}
          </span>
          <blockquote class="quote__text">{{ block.settings.quote }}</blockquote>
          <p class="quote__by"><strong>{{ block.settings.author }}</strong>{% if block.settings.detail != blank %}<span>{{ block.settings.detail }}</span>{% endif %}</p>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by thousands" },
    { "type": "checkbox", "id": "surface", "label": "Use light background", "default": false }
  ],
  "blocks": [
    { "type": "quote", "name": "Quote", "settings": [
      { "type": "textarea", "id": "quote", "label": "Quote", "default": "Exactly what I was looking for. Arrived in two days and the quality is even better in person." },
      { "type": "text", "id": "author", "label": "Name", "default": "Priya S." },
      { "type": "text", "id": "detail", "label": "Detail (city, product…)", "default": "Bengaluru" },
      { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 }
    ] }
  ],
  "default_blocks": [
    { "type": "quote", "settings": { "quote": "Exactly what I was looking for. Arrived in two days and the quality is even better in person.", "author": "Priya S.", "detail": "Bengaluru", "rating": 5 } },
    { "type": "quote", "settings": { "quote": "I've reordered three times now. Packaging is thoughtful and nothing's ever been late.", "author": "Arjun M.", "detail": "Pune", "rating": 5 } },
    { "type": "quote", "settings": { "quote": "Paid cash on delivery the first time, now I just pay online. Returns were painless too.", "author": "Neha K.", "detail": "Delhi", "rating": 5 } },
    { "type": "quote", "settings": { "quote": "Simple, well made and fairly priced. Customer support actually replied within the hour.", "author": "Rahul D.", "detail": "Kochi", "rating": 4 } }
  ],
  "max_blocks": 10
}
{% endschema %}
