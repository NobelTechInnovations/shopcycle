{% comment %}
  Section heading row: optional eyebrow, title, subtitle and a "view all"
  link. Pass `eyebrow`, `title`, `subtitle`, `link_url`, `link_text`,
  `align` ('left' | 'center').
{% endcomment %}
{% if title != blank or eyebrow != blank %}
<div class="shead shead--{{ align | default: 'left' }}">
  <div class="shead__text">
    {% if eyebrow != blank %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
    {% if title != blank %}<h2 class="h2">{{ title }}</h2>{% endif %}
    {% if subtitle != blank %}<p class="shead__sub">{{ subtitle }}</p>{% endif %}
  </div>
  {% if link_url != blank and link_text != blank %}
    <a class="arrow-link" href="{{ link_url }}"><span>{{ link_text }}</span>{% render 'snippets/icon', icon: 'arrow-up-right', class: 'icon icon--sm' %}</a>
  {% endif %}
</div>
{% endif %}
