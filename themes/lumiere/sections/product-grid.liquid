{% comment %}
  Products from a collection, best sellers (real sales in the last 90
  days) or the newest arrivals. With nothing to show yet, example cards
  keep the layout — they disappear as soon as there are real products.
{% endcomment %}
{% case section.settings.source %}
  {% when 'best_sellers' %}{% assign items = best_sellers %}{% assign view_url = routes.all_products_url | append: '?sort=best-selling' %}
  {% when 'newest' %}{% assign items = collections.all.products | sort: 'created_at' | reverse %}{% assign view_url = routes.all_products_url | append: '?sort=newest' %}
  {% else %}
    {% assign chosen = collections[section.settings.collection] | default: collections.all %}
    {% assign items = chosen.products %}{% assign view_url = chosen.url | default: routes.all_products_url %}
{% endcase %}
<section class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="container">
    {% render 'snippets/section-head', eyebrow: section.settings.eyebrow, title: section.settings.heading, subtitle: section.settings.subheading, align: section.settings.align, link_url: view_url, link_text: section.settings.link_text %}
    <div class="grid grid--{{ section.settings.mobile }}" style="--cols: {{ section.settings.columns }}">
      {% if items.size > 0 %}
        {% for product in items limit: section.settings.limit %}
          {% render 'snippets/product-card', product: product, eager: false %}
        {% endfor %}
      {% else %}
        {% for i in (1..section.settings.columns) %}
          {% render 'snippets/product-card-placeholder', index: i %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New arrivals" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "" },
    { "type": "select", "id": "align", "label": "Heading alignment", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }] },
    { "type": "select", "id": "source", "label": "Show", "default": "newest", "options": [
      { "value": "collection", "label": "A collection" },
      { "value": "best_sellers", "label": "Best sellers" },
      { "value": "newest", "label": "Newest products" }
    ] },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "Per row on desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "select", "id": "mobile", "label": "On phones", "default": "slider", "options": [
      { "value": "two", "label": "Grid (2 per row)" },
      { "value": "slider", "label": "Swipe row" }
    ] },
    { "type": "text", "id": "link_text", "label": "\"View all\" link text", "default": "View all" },
    { "type": "checkbox", "id": "surface", "label": "Use light background", "default": false }
  ]
}
{% endschema %}
