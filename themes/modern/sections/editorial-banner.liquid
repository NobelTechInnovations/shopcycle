<section class="editorial-banner editorial-banner--{{ section.settings.layout }}">
  <div class="editorial-banner__media">
    {% if section.settings.image != blank %}
      <img src="{{ section.settings.image | image_url }}" alt="">
    {% else %}
      {% render 'snippets/image-placeholder' %}
    {% endif %}
  </div>
  <div class="editorial-banner__caption">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
    {% if section.settings.button_text != blank %}
      {% assign btn_url = section.settings.button_link | default: routes.all_products_url %}
      {% render 'snippets/button', text: section.settings.button_text, url: btn_url %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Editorial image",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Crafted for everyday" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "button_text", "label": "Button text" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "image-left",
      "options": [{"value":"image-left","label":"Image left"},{"value":"image-right","label":"Image right"}] }
  ]
}
{% endschema %}
