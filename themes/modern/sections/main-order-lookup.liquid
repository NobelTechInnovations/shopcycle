{% render 'snippets/oy-customer-styles' %}
<section class="oy-page">
  <p class="oy-eyebrow">{{ shop.name }}</p>
  <h1 class="oy-title">Find your order</h1>
  <p class="oy-lede">Enter your order number and the email you used at checkout.</p>

  <div class="oy-card">
    {% if form_error %}<p class="oy-alert oy-alert--error" role="alert">{{ form_error }}</p>{% endif %}
    <form method="post" action="{{ routes.order_lookup_url }}">
      <label class="oy-field"><span>Order number</span><input class="oy-input" name="orderNumber" inputmode="numeric" required placeholder="1001"></label>
      <label class="oy-field"><span>Email</span><input class="oy-input" type="email" name="email" autocomplete="email" required placeholder="you@example.com"></label>
      <button type="submit" class="oy-btn oy-btn--block">Find order</button>
    </form>
  </div>
  <p class="oy-small oy-muted" style="margin-top:20px">Have an account? <a class="oy-link" href="{{ routes.account_login_url }}">Sign in</a> to see all your orders.</p>
</section>

{% schema %}
{
  "name": "Order lookup",
  "settings": []
}
{% endschema %}
