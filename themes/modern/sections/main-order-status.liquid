{% render 'snippets/oy-customer-styles' %}
<section class="oy-page oy-page--wide">
  <div class="oy-head">
    <div>
      <p class="oy-eyebrow">{{ shop.name }} · Placed {{ order.date }}</p>
      <h1 class="oy-title" style="margin:0">Order {{ order.name }}</h1>
    </div>
    <span class="oy-pill oy-pill--{{ order.status.key }}" style="font-size:13px;padding:6px 12px">{{ order.status.label }}</span>
  </div>

  {% if notice %}<p class="oy-alert oy-alert--ok" role="status">{{ notice }}</p>{% endif %}
  {% if form_error %}<p class="oy-alert oy-alert--error" role="alert">{{ form_error }}</p>{% endif %}

  {% if order.cancelled %}
    <p class="oy-alert oy-alert--error">This order was cancelled{% if order.cancelReason %} — {{ order.cancelReason }}{% endif %}.{% if order.refundedAmount > 0 %} {{ order.refundedAmount | money }} has been refunded.{% endif %}</p>
  {% else %}
    <div class="oy-card" style="margin-bottom:20px">
      <ol class="oy-steps" aria-label="Order progress">
        {% for step in order.steps %}
          <li class="oy-step{% if step.done %} is-done{% endif %}">
            <strong>{{ step.label }}</strong>
            {% if step.date %}<span>{{ step.date }}</span>{% endif %}
          </li>
        {% endfor %}
      </ol>
    </div>
  {% endif %}

  <div class="oy-grid">
    <div>
      {% for shipment in order.shipments %}
        <div class="oy-card">
          <h2>{% if shipment.status == "delivered" %}Delivered {{ shipment.delivered_on }}{% else %}Shipped {{ shipment.shipped_on }}{% endif %}</h2>
          <p class="oy-muted" style="margin:0 0 14px">
            {{ shipment.itemCount }} item{% if shipment.itemCount != 1 %}s{% endif %}{% if shipment.courier %} via {{ shipment.courier }}{% endif %}
            {% if shipment.trackingNumber %}<br>Tracking number <strong style="color:var(--color-text,#1a1a1a)">{{ shipment.trackingNumber }}</strong>{% endif %}
          </p>
          {% if shipment.trackingUrl %}<a class="oy-btn" href="{{ shipment.trackingUrl }}" target="_blank" rel="noopener noreferrer">Track package</a>{% endif %}
        </div>
      {% endfor %}

      <div class="oy-card">
        <h2>Items</h2>
        {% for item in order.items %}
          <div class="oy-row"><span>{{ item.title }} <span class="oy-muted">× {{ item.quantity }}</span></span><span class="oy-num">{{ item.total | money }}</span></div>
        {% endfor %}
        <div style="margin-top:8px">
          <div class="oy-row"><span class="oy-muted">Subtotal</span><span class="oy-num">{{ order.subtotal | money }}</span></div>
          {% if order.discount > 0 %}<div class="oy-row"><span class="oy-muted">Discount{% if order.discountCode %} ({{ order.discountCode }}){% endif %}</span><span class="oy-num">−{{ order.discount | money }}</span></div>{% endif %}
          <div class="oy-row"><span class="oy-muted">Shipping</span><span class="oy-num">{% if order.shipping > 0 %}{{ order.shipping | money }}{% else %}Free{% endif %}</span></div>
          {% if order.tax > 0 %}<div class="oy-row"><span class="oy-muted">Tax</span><span class="oy-num">{{ order.tax | money }}</span></div>{% endif %}
          <div class="oy-row oy-row--total"><span>Total</span><span class="oy-num">{{ order.total | money }}</span></div>
          {% for refund in order.refunds %}
            <div class="oy-row"><span class="oy-muted">Refunded {{ refund.date }}</span><span class="oy-num">−{{ refund.amount | money }}</span></div>
          {% endfor %}
        </div>
      </div>

      {% if order.canReturn %}
        <div class="oy-card">
          <details class="oy-details">
            <summary>Return items</summary>
            <p class="oy-muted oy-small" style="margin:12px 0 16px">Returns are open until {{ order.returnDeadline }}. Choose what you'd like to send back and we'll get back to you.</p>
            <form method="post" action="{{ order.return_url }}">
              {% for item in order.items %}
                {% if item.returnable > 0 %}
                  <label class="oy-row" style="align-items:center">
                    <span>{{ item.title }}</span>
                    <select class="oy-select" name="qty_{{ item.id }}" style="width:auto;min-width:90px">
                      <option value="0">Keep</option>
                      {% for n in (1..item.returnable) %}<option value="{{ n }}">Return {{ n }}</option>{% endfor %}
                    </select>
                  </label>
                {% endif %}
              {% endfor %}
              <label class="oy-field" style="margin-top:16px"><span>Reason</span>
                <select class="oy-select" name="reason" required>
                  <option value="">Choose a reason</option>
                  <option>Wrong size or fit</option>
                  <option>Damaged or defective</option>
                  <option>Not as described</option>
                  <option>Received the wrong item</option>
                  <option>Changed my mind</option>
                  <option>Other</option>
                </select>
              </label>
              <label class="oy-field"><span>Anything else? (optional)</span><textarea class="oy-textarea" name="note" maxlength="2000"></textarea></label>
              <button type="submit" class="oy-btn">Request return</button>
            </form>
          </details>
        </div>
      {% endif %}
      {% for ret in order.returns %}
        <div class="oy-card">
          <h2>{{ ret.status_label }}</h2>
          <p class="oy-muted" style="margin:0">Requested {{ ret.date }}{% if ret.merchantNote %} · {{ ret.merchantNote }}{% endif %}</p>
        </div>
      {% endfor %}
    </div>

    <div>
      <div class="oy-card">
        <h2>Delivery</h2>
        <p style="margin:0;line-height:1.6">{{ order.shippingName }}<br>
        {{ order.shippingAddress1 }}{% if order.shippingAddress2 %}, {{ order.shippingAddress2 }}{% endif %}<br>
        {{ order.shippingCity }}, {{ order.shippingProvince }} {{ order.shippingZip }}</p>
      </div>
      <div class="oy-card">
        <h2>Payment</h2>
        <p style="margin:0">{% if order.paymentMethod == "cod" %}Cash on delivery{% if order.paymentStatus == "pending" %} · pay {{ order.total | money }} when it arrives{% endif %}{% else %}Paid online{% endif %}</p>
        {% if order.invoiceUrl %}<p style="margin:12px 0 0"><a class="oy-link" href="{{ order.invoiceUrl }}" target="_blank" rel="noopener">Download GST invoice ({{ order.invoiceNumber }})</a></p>{% endif %}
      </div>
      <div class="oy-card">
        <h2>Need help?</h2>
        <p class="oy-muted" style="margin:0">{% if shop.support_email %}Write to <a class="oy-link" href="mailto:{{ shop.support_email }}">{{ shop.support_email }}</a>{% if shop.support_phone %} or call {{ shop.support_phone }}{% endif %} — mention order {{ order.name }}.{% else %}Reply to your order confirmation email and mention order {{ order.name }}.{% endif %}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Order status",
  "settings": []
}
{% endschema %}
