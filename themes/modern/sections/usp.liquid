<section class="usp usp--modern">
  {% for block in section.blocks %}
    <div class="usp__item">
      <span class="usp__icon">{% render 'snippets/icon', icon: block.settings.icon, class: 'icon' %}</span>
      <p class="usp__title">{{ block.settings.title }}</p>
      <p class="usp__text">{{ block.settings.text }}</p>
    </div>
  {% endfor %}
</section>

{% schema %}
{
  "name": "USP row",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "box", "label": "Package" },
          { "value": "check-circle", "label": "Check" },
          { "value": "chat", "label": "Chat" },
          { "value": "lock", "label": "Lock" },
          { "value": "truck", "label": "Truck" }
        ], "default": "box" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Description" }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
