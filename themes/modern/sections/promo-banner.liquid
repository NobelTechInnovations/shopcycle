<section class="promo-banner"
  style="background: {{ section.settings.background }}; color: {{ section.settings.text_color }}; {% if section.settings.image != blank %}background-image: url('{{ section.settings.image | image_url }}');{% endif %}">
  {% if section.settings.image != blank %}
    <div class="promo-banner__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  {% endif %}
  <div class="promo-banner__content">
    {% if section.settings.eyebrow != blank %}<p class="promo-banner__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.subheading != blank %}<p class="promo-banner__subheading">{{ section.settings.subheading }}</p>{% endif %}
    {% if section.settings.show_countdown %}
      <div class="promo-banner__countdown" data-countdown-minutes="{{ section.settings.countdown_minutes }}">
        <div><strong class="js-cd-days">00</strong><span>Days</span></div>
        <div><strong class="js-cd-hours">00</strong><span>Hrs</span></div>
        <div><strong class="js-cd-mins">00</strong><span>Min</span></div>
        <div><strong class="js-cd-secs">00</strong><span>Sec</span></div>
      </div>
    {% endif %}
    {% if section.settings.button_text != blank %}
      {% assign btn_url = section.settings.button_link | default: routes.all_products_url %}
      {% render 'snippets/button', text: section.settings.button_text, url: btn_url %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Promo banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Free shipping over ₹1499" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "button_text", "label": "Button text" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Background" },
    { "type": "color", "id": "background", "label": "Background color", "default": "#111111" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFF8EE" },
    { "type": "image_picker", "id": "image", "label": "Background image (optional)" },
    { "type": "range", "id": "overlay_opacity", "label": "Image overlay darkness", "min": 0, "max": 80, "step": 5, "default": 30 },
    { "type": "header", "content": "Countdown" },
    { "type": "checkbox", "id": "show_countdown", "label": "Show countdown", "default": false },
    { "type": "number", "id": "countdown_minutes", "label": "Countdown length (minutes from page load)", "default": 1440 }
  ]
}
{% endschema %}
