<section class="rich-text">
  <h2>{{ section.settings.heading }}</h2>
  <div class="rich-text__body">{{ section.settings.content }}</div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "content", "label": "Content" }
  ]
}
{% endschema %}
