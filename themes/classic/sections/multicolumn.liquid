{% comment %} Reasons to buy: icon, title and a line of text per column. {% endcomment %}
<section class="section section--tight{% if section.settings.surface %} section--surface{% endif %}">
  <div class="container">
    {% render 'snippets/section-head', title: section.settings.heading, align: 'center' %}
    <ul class="features features--{{ section.settings.style }}" style="--cols: {{ section.blocks.size | at_most: 4 | at_least: 1 }}">
      {% for block in section.blocks %}
        <li class="feature">
          <span class="feature__icon">{% render 'snippets/icon', icon: block.settings.icon %}</span>
          <div>
            <h3 class="feature__title">{{ block.settings.title }}</h3>
            {% if block.settings.text != blank %}<p class="feature__text">{{ block.settings.text }}</p>{% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Features",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "" },
    { "type": "select", "id": "style", "label": "Style", "default": "inline", "options": [
      { "value": "inline", "label": "Icon beside text" },
      { "value": "stacked", "label": "Icon above text, centred" },
      { "value": "boxed", "label": "In cards" }
    ] },
    { "type": "checkbox", "id": "surface", "label": "Use alternate background", "default": false }
  ],
  "blocks": [
    { "type": "column", "name": "Column", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
        { "value": "truck", "label": "Delivery" },
        { "value": "cash", "label": "Cash on delivery" },
        { "value": "return", "label": "Returns" },
        { "value": "shield", "label": "Secure / quality" },
        { "value": "leaf", "label": "Natural" },
        { "value": "star", "label": "Star" },
        { "value": "gift", "label": "Gift" },
        { "value": "chat", "label": "Support" },
        { "value": "heart", "label": "Heart" },
        { "value": "sparkle", "label": "Sparkle" }
      ] },
      { "type": "text", "id": "title", "label": "Title", "default": "Free delivery" },
      { "type": "text", "id": "text", "label": "Text", "default": "On orders over ₹999" }
    ] }
  ],
  "max_blocks": 4
}
{% endschema %}
