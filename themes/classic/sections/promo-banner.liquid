{% comment %}
  Offer banner with an optional countdown to a real end date — it hides
  itself once the offer is over (no fake timers that restart per visit).
{% endcomment %}
<section class="section section--flush-{{ section.settings.full_width }}">
  <div class="{% unless section.settings.full_width %}container{% endunless %}">
    <div class="promo promo--{{ section.settings.text_color }} promo--{{ section.settings.align }}" style="--promo-bg: {{ section.settings.background }}">
      <div class="promo__media">
        {% if section.settings.image != blank %}<img src="{{ section.settings.image | image_url }}" alt="" loading="lazy" width="2000" height="900">{% endif %}
      </div>
      <div class="promo__content">
        {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        <h2 class="display display--md">{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}<p class="promo__sub">{{ section.settings.text }}</p>{% endif %}
        {% if section.settings.ends_at != blank %}
          <div class="countdown" data-countdown="{{ section.settings.ends_at }}" hidden>
            <span><b data-d>0</b><small>Days</small></span>
            <span><b data-h>0</b><small>Hours</small></span>
            <span><b data-m>0</b><small>Min</small></span>
            <span><b data-s>0</b><small>Sec</small></span>
          </div>
        {% endif %}
        {% if section.settings.button_text != blank %}
          <a class="btn {% if section.settings.text_color == 'light' %}btn--light{% endif %}" href="{{ section.settings.button_link | default: routes.all_products_url }}">{{ section.settings.button_text }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "color", "id": "background", "label": "Background colour (without image)", "default": "#1F2A24" },
    { "type": "select", "id": "text_color", "label": "Text colour", "default": "light", "options": [{ "value": "light", "label": "Light" }, { "value": "dark", "label": "Dark" }] },
    { "type": "select", "id": "align", "label": "Text position", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }] },
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "Limited time" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The festive edit — up to 40% off" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Gift-ready favourites, while stocks last." },
    { "type": "text", "id": "ends_at", "label": "Countdown ends (YYYY-MM-DD HH:MM, IST)", "default": "" },
    { "type": "paragraph", "content": "Leave the date empty for no countdown. The timer disappears when the offer ends." },
    { "type": "text", "id": "button_text", "label": "Button", "default": "Shop the offer" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "full_width", "label": "Edge to edge", "default": false }
  ]
}
{% endschema %}
