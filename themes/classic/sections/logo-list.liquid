{% comment %} "As featured in" / brand logos. {% endcomment %}
<section class="section section--tight{% if section.settings.surface %} section--surface{% endif %}">
  <div class="container">
    {% if section.settings.heading != blank %}<p class="logos__heading">{{ section.settings.heading }}</p>{% endif %}
    <ul class="logos{% if section.settings.muted %} logos--muted{% endif %}">
      {% for block in section.blocks %}
        <li>
          {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}
          {% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.name }}" loading="lazy" width="240" height="80">{% else %}<span class="logos__text">{{ block.settings.name }}</span>{% endif %}
          {% if block.settings.link != blank %}</a>{% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Logo list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "As featured in" },
    { "type": "checkbox", "id": "muted", "label": "Show logos in grey", "default": true },
    { "type": "checkbox", "id": "surface", "label": "Use alternate background", "default": false }
  ],
  "blocks": [
    { "type": "logo", "name": "Logo", "settings": [
      { "type": "image_picker", "id": "image", "label": "Logo" },
      { "type": "text", "id": "name", "label": "Name (shown if no logo)", "default": "Brand" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "max_blocks": 8
}
{% endschema %}
