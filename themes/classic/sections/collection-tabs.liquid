{% comment %}
  Several collections behind tabs ("Women · Men · Kids"). Works without
  JavaScript: every panel renders; theme.js turns them into tabs.
{% endcomment %}
<section class="section{% if section.settings.surface %} section--surface{% endif %}" data-tabs>
  <div class="container">
    {% render 'snippets/section-head', title: section.settings.heading, subtitle: section.settings.subheading, align: 'center' %}
    {% if section.blocks.size > 1 %}
      <div class="tabs" role="tablist" aria-label="{{ section.settings.heading | default: 'Collections' }}">
        {% for block in section.blocks %}
          {% assign coll = collections[block.settings.collection] %}
          <button type="button" class="tabs__tab{% if forloop.first %} is-active{% endif %}" role="tab" id="tab-{{ section.id }}-{{ forloop.index }}" aria-controls="panel-{{ section.id }}-{{ forloop.index }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-tab>{{ block.settings.title | default: coll.title | default: 'Collection' }}</button>
        {% endfor %}
      </div>
    {% endif %}
    {% for block in section.blocks %}
      {% assign coll = collections[block.settings.collection] | default: collections.all %}
      <div class="tabs__panel{% if forloop.first %} is-active{% endif %}" role="tabpanel" id="panel-{{ section.id }}-{{ forloop.index }}" aria-labelledby="tab-{{ section.id }}-{{ forloop.index }}" data-panel>
        <div class="products products--slider" style="--cols: 4">
          {% for product in coll.products limit: section.settings.limit %}
            {% render 'snippets/product-card', product: product %}
          {% else %}
            {% for i in (1..4) %}{% render 'snippets/product-card-placeholder', index: i %}{% endfor %}
          {% endfor %}
        </div>
        <div class="center-row"><a class="btn btn--ghost" href="{{ coll.url }}">Shop {{ block.settings.title | default: coll.title }}</a></div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Collection tabs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trending now" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "" },
    { "type": "range", "id": "limit", "label": "Products per tab", "min": 4, "max": 12, "step": 4, "default": 8 },
    { "type": "checkbox", "id": "surface", "label": "Use alternate background", "default": false }
  ],
  "blocks": [
    { "type": "tab", "name": "Tab", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "title", "label": "Tab name (optional)", "default": "" }
    ] }
  ],
  "max_blocks": 5
}
{% endschema %}
