{% comment %}
  Falls back to the store's own real collections (skipping the synthetic
  "all" one) when none are explicitly picked, and hides entirely if the
  store truly has zero collections — same reasoning as Modern's
  category-grid.liquid: a fresh install shouldn't show a heading over an
  empty row just because nobody has curated this section yet.
{% endcomment %}
{% assign auto_handles = "" | split: "," %}
{% for c in collections %}
  {% unless c[0] == "all" %}
    {% assign auto_handles = auto_handles | push: c[0] %}
  {% endunless %}
{% endfor %}
{% assign display_handles = section.settings.collections | default: auto_handles %}

{% if display_handles.size > 0 %}
<section class="collection-list">
  <h2>{{ section.settings.heading }}</h2>
  {% comment %}
    A fixed-width flex row (not a stretchy grid) so "3 collections, centered"
    actually looks centered instead of 3 tiles stretched to fill whatever
    column count a grid happened to have — this is what made the alignment
    setting below actually do something.
  {% endcomment %}
  <div class="collection-list__grid collection-list__grid--{{ section.settings.alignment }}">
    {% for handle in display_handles limit: 4 %}
      {% assign coll = collections[handle] %}
      {% if coll %}
        <a href="{{ routes.collections_url }}/{{ handle }}" class="collection-list__tile">
          {% if coll.image != blank %}
            <img src="{{ coll.image | image_url }}" alt="">
          {% else %}
            {% render 'snippets/image-placeholder' %}
          {% endif %}
          <span>{{ coll.title }}</span>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Collection list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "collection_list", "id": "collections", "label": "Collections", "default": [],
      "info": "Pick as many as you like — each tile shows that collection's own cover photo and name automatically." },
    { "type": "select", "id": "alignment", "label": "Alignment", "default": "left",
      "options": [{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}] }
  ]
}
{% endschema %}
