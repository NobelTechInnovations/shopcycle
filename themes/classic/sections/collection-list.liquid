{% comment %}
  Shop-by-collection row. Style: circles (small round thumbnails), cards
  (photo with the name beneath) or tiles (name over the photo). Each block
  picks a collection; its own image overrides the collection's.
{% endcomment %}
<section class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="container">
    {% render 'snippets/section-head', eyebrow: section.settings.eyebrow, title: section.settings.heading, subtitle: section.settings.subheading, align: section.settings.align, link_url: routes.all_products_url, link_text: section.settings.link_text %}
    <div class="clist clist--{{ section.settings.style }}" style="--cols: {{ section.settings.columns }}">
      {% for block in section.blocks %}
        {% assign coll = collections[block.settings.collection] %}
        {% assign coll_img = block.settings.image | default: coll.image %}
        {% if coll_img == blank and coll.products.size > 0 %}{% assign coll_img = coll.products[0].featured_image.url %}{% endif %}
        <a class="clist__item" href="{% if coll %}{{ coll.url }}{% else %}{{ routes.all_products_url }}{% endif %}">
          <span class="clist__media">
            {% if coll_img != blank %}<img src="{{ coll_img | image_url }}" alt="" loading="lazy" width="600" height="600">{% else %}{% render 'snippets/placeholder', kind: 'collection' %}{% endif %}
            {% if section.settings.style == 'tiles' %}<span class="clist__overlay"><span class="clist__name">{{ block.settings.title | default: coll.title | default: 'Collection' }}</span>{% render 'snippets/icon', icon: 'arrow-right' %}</span>{% endif %}
          </span>
          {% unless section.settings.style == 'tiles' %}
            <span class="clist__name">{{ block.settings.title | default: coll.title | default: 'Collection' }}</span>
            {% if section.settings.show_count and coll %}<span class="clist__count">{{ coll.products.size }} product{% if coll.products.size != 1 %}s{% endif %}</span>{% endif %}
          {% endunless %}
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "" },
    { "type": "select", "id": "align", "label": "Heading alignment", "default": "center", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }] },
    { "type": "select", "id": "style", "label": "Style", "default": "circles", "options": [
      { "value": "circles", "label": "Circles" },
      { "value": "cards", "label": "Cards" },
      { "value": "tiles", "label": "Tiles (name on photo)" }
    ] },
    { "type": "range", "id": "columns", "label": "Per row on desktop", "min": 2, "max": 6, "step": 1, "default": 5 },
    { "type": "checkbox", "id": "show_count", "label": "Show product count", "default": false },
    { "type": "text", "id": "link_text", "label": "\"View all\" link text", "default": "" },
    { "type": "checkbox", "id": "surface", "label": "Use alternate background", "default": false }
  ],
  "blocks": [
    { "type": "collection", "name": "Collection", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "title", "label": "Name (optional)", "default": "" },
      { "type": "image_picker", "id": "image", "label": "Image (optional)" }
    ] }
  ],
  "max_blocks": 12
}
{% endschema %}
