{% comment %}
  Hero slideshow. Each slide is a block: image (optional separate phone
  image), eyebrow, heading, text, two buttons, text position and colour.
  One slide = a static hero; two or more = arrows, dots and autoplay
  (pauses on hover and for visitors who prefer reduced motion).
{% endcomment %}
<section class="slideshow slideshow--{{ section.settings.height }}" data-slideshow data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.speed }}" aria-roledescription="carousel" aria-label="{{ section.settings.label | default: 'Featured' }}">
  <div class="slideshow__track">
    {% for block in section.blocks %}
      <div class="slide slide--{{ block.settings.position }} slide--{{ block.settings.text_color }}{% if forloop.first %} is-active{% endif %}" data-slide role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ section.blocks.size }}" {% unless forloop.first %}aria-hidden="true"{% endunless %}>
        <div class="slide__media">
          {% if block.settings.image != blank %}
            <picture>
              {% if block.settings.image_mobile != blank %}<source media="(max-width: 749px)" srcset="{{ block.settings.image_mobile | image_url }}">{% endif %}
              <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.alt }}" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %} width="2400" height="1200">
            </picture>
          {% else %}
            {% render 'snippets/placeholder', kind: 'lifestyle' %}
          {% endif %}
          <span class="slide__scrim" style="opacity: {{ block.settings.overlay | divided_by: 100.0 }}"></span>
        </div>
        <div class="container slide__content">
          <div class="slide__text">
            {% if block.settings.eyebrow != blank %}<p class="eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
            {% if block.settings.heading != blank %}
              {% if forloop.first %}<h1 class="display">{{ block.settings.heading }}</h1>{% else %}<h2 class="display">{{ block.settings.heading }}</h2>{% endif %}
            {% endif %}
            {% if block.settings.text != blank %}<p class="slide__sub">{{ block.settings.text }}</p>{% endif %}
            {% if block.settings.button_text != blank or block.settings.button2_text != blank %}
              <div class="btn-row">
                {% if block.settings.button_text != blank %}<a class="btn {% if block.settings.text_color == 'light' %}btn--light{% endif %}" href="{{ block.settings.button_link | default: routes.all_products_url }}">{{ block.settings.button_text }}</a>{% endif %}
                {% if block.settings.button2_text != blank %}<a class="btn btn--ghost {% if block.settings.text_color == 'light' %}btn--ghost-light{% endif %}" href="{{ block.settings.button2_link | default: routes.all_products_url }}">{{ block.settings.button2_text }}</a>{% endif %}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
    {% if section.blocks.size == 0 %}
      <div class="slide slide--left slide--dark is-active" data-slide>
        <div class="slide__media">{% render 'snippets/placeholder', kind: 'lifestyle' %}</div>
        <div class="container slide__content"><div class="slide__text"><h1 class="display">Add a slide</h1><p class="slide__sub">Upload a photo and write a headline in the theme editor.</p></div></div>
      </div>
    {% endif %}
  </div>
  {% if section.blocks.size > 1 %}
    <div class="container slideshow__controls">
      <button type="button" class="icon-btn icon-btn--round" data-slide-prev aria-label="Previous slide">{% render 'snippets/icon', icon: 'chevron-left' %}</button>
      <div class="slideshow__dots" role="tablist">
        {% for block in section.blocks %}
          <button type="button" class="slideshow__dot{% if forloop.first %} is-active{% endif %}" data-slide-dot="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
        {% endfor %}
      </div>
      <button type="button" class="icon-btn icon-btn--round" data-slide-next aria-label="Next slide">{% render 'snippets/icon', icon: 'chevron-right' %}</button>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Slideshow",
  "settings": [
    { "type": "select", "id": "height", "label": "Height", "default": "large", "options": [
      { "value": "small", "label": "Small" },
      { "value": "medium", "label": "Medium" },
      { "value": "large", "label": "Large" },
      { "value": "full", "label": "Full screen" }
    ] },
    { "type": "checkbox", "id": "autoplay", "label": "Change slides automatically", "default": true },
    { "type": "range", "id": "speed", "label": "Seconds per slide", "min": 3, "max": 10, "step": 1, "default": 6 },
    { "type": "text", "id": "label", "label": "Name for screen readers", "default": "Featured" }
  ],
  "blocks": [
    { "type": "slide", "name": "Slide", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image (desktop)" },
      { "type": "image_picker", "id": "image_mobile", "label": "Image for phones (optional)" },
      { "type": "text", "id": "alt", "label": "Image description", "default": "" },
      { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "New season" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Made to be lived in" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Everyday pieces in natural fabrics, delivered to your door." },
      { "type": "text", "id": "button_text", "label": "Button", "default": "Shop now" },
      { "type": "url", "id": "button_link", "label": "Button link" },
      { "type": "text", "id": "button2_text", "label": "Second button", "default": "" },
      { "type": "url", "id": "button2_link", "label": "Second button link" },
      { "type": "select", "id": "position", "label": "Text position", "default": "left", "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Right" }
      ] },
      { "type": "select", "id": "text_color", "label": "Text colour", "default": "dark", "options": [
        { "value": "dark", "label": "Dark (for light photos)" },
        { "value": "light", "label": "Light (for dark photos)" }
      ] },
      { "type": "range", "id": "overlay", "label": "Darken photo (%)", "min": 0, "max": 70, "step": 5, "default": 0 }
    ] }
  ],
  "max_blocks": 5
}
{% endschema %}
