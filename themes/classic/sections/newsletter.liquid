{% comment %}
  Email signup. A signup becomes a customer with email-marketing consent
  (Customers in the admin). Messages come back as ?notice= / ?formError=.
{% endcomment %}
<section class="section" id="newsletter">
  <div class="container">
    <div class="newsletter newsletter--{{ section.settings.text_color }}" style="--nl-bg: {{ section.settings.background }}">
      <div class="newsletter__text">
        <h2 class="h2">{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
      </div>
      <div class="newsletter__form">
        {% if notice %}<p class="note note--ok" role="status">{{ notice }}</p>{% endif %}
        {% if form_error %}<p class="note note--error" role="alert">{{ form_error }}</p>{% endif %}
        <form class="inline-form" method="post" action="{{ routes.newsletter_url }}">
          <input type="hidden" name="return_to" value="{{ routes.root_url }}">
          <label class="visually-hidden" for="nl-email-{{ section.id }}">Email</label>
          <input id="nl-email-{{ section.id }}" type="email" name="email" required placeholder="Your email address" autocomplete="email">
          <button type="submit" class="btn {% if section.settings.text_color == 'light' %}btn--light{% endif %}">{{ section.settings.button_text }}</button>
        </form>
        <p class="newsletter__fine">We'll only email you about {{ shop.name }}. Unsubscribe any time.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 10% off your first order" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Join our list for new arrivals, restocks and members-only offers." },
    { "type": "text", "id": "button_text", "label": "Button", "default": "Subscribe" },
    { "type": "color", "id": "background", "label": "Background", "default": "#F6F3EE" },
    { "type": "select", "id": "text_color", "label": "Text colour", "default": "dark", "options": [{ "value": "dark", "label": "Dark" }, { "value": "light", "label": "Light" }] }
  ]
}
{% endschema %}
