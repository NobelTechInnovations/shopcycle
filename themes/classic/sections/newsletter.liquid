<section class="newsletter">
  <h2>{{ section.settings.heading }}</h2>
  <p>{{ section.settings.subheading }}</p>
  {% render 'snippets/newsletter-form' %}
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join our newsletter" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Get 10% off your first order" },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Enter your email" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Subscribe" }
  ]
}
{% endschema %}
