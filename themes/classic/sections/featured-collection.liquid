<section class="featured-collection">
  <h2>{{ section.settings.heading }}</h2>
  <div class="product-grid">
    {% comment %}
      Falls back to collections.all (every active product — see
      storefront/service.js) when no collection has been picked yet, same
      reasoning as Modern's product-grid.liquid: a fresh install shouldn't
      show this heading over an empty grid just because nobody has pointed
      it at a specific collection.
    {% endcomment %}
    {% if section.settings.collection != blank %}
      {% assign target = collections[section.settings.collection] %}
    {% else %}
      {% assign target = collections.all %}
    {% endif %}
    {% for product in target.products limit: section.settings.products_to_show %}
      {% render 'snippets/product-card', product: product %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured products" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 }
  ]
}
{% endschema %}
