<section class="product-grid-section">
  {% if search %}
    {% if search.query != blank %}
      <h2>Search results for &ldquo;{{ search.query }}&rdquo;</h2>
    {% else %}
      <h2>Search</h2>
    {% endif %}
    <p class="product-grid-section__count">{{ search.result_count }} result{% if search.result_count != 1 %}s{% endif %}</p>
  {% else %}
    <h2>{{ section.settings.heading }}</h2>
  {% endif %}
  <div class="product-grid" style="--product-grid-cols: {{ section.settings.columns }};">
    {% comment %}
      Used three ways: a merchant-placed "product grid" pointing at a named
      collection (settings.collection set), the collection template's main
      listing (whatever collection is currently being viewed), or the
      search results template (a synthetic "collection" built in
      storefront/service.js from an in-memory title match).
    {% endcomment %}
    {% if section.settings.collection != blank %}
      {% assign target = collections[section.settings.collection] %}
      {% assign target_limit = 999 %}
    {% elsif collection %}
      {% assign target = collection %}
      {% assign target_limit = 999 %}
    {% else %}
      {% comment %} Placed with no collection chosen and no "current
        collection" in context (e.g. dropped on the homepage) — fall back
        to every active product rather than rendering nothing. {% endcomment %}
      {% assign target = collections.all %}
      {% assign target_limit = 8 %}
    {% endif %}
    {% for product in target.products limit: target_limit %}
      {% render 'snippets/product-card', product: product %}
    {% endfor %}
  </div>
  {% if search and search.result_count == 0 %}
    <p class="product-grid-section__empty">No products matched "{{ search.query }}".</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Product grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop all" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 6, "step": 1, "default": 4 }
  ]
}
{% endschema %}
