{% comment %}
  Product card for home page sections. Expects `product` (serialized).
  Quick add posts the cheapest in-stock variant straight to the cart when
  the product has a single option; otherwise it links to the product.
{% endcomment %}
{% assign pv = product.price_variant | default: product.variants.first %}
<article class="card">
  <a class="card__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {% if product.images.size > 0 %}
      <img src="{{ product.images[0].url }}" alt="" loading="lazy" width="800" height="1000">
      {% if settings.card_hover_image and product.images.size > 1 %}
        <img class="card__hover" src="{{ product.images[1].url }}" alt="" loading="lazy" width="800" height="1000">
      {% endif %}
    {% else %}
      {% render 'snippets/placeholder', kind: 'image' %}
    {% endif %}
    <span class="card__badges">
      {% unless product.available %}
        <span class="badge badge--dark">Sold out</span>
      {% else %}
        {% if product.on_sale %}<span class="badge badge--sale">−{{ product.discount_percent }}%</span>{% endif %}
      {% endunless %}
    </span>
  </a>
  {% if settings.card_quick_add and product.available %}
    {% if product.variants.size == 1 %}
      <form class="card__quick" method="post" action="{{ routes.cart_add_url }}" data-product-title="{{ product.title | escape }}">
        <input type="hidden" name="variantId" value="{{ pv.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="card__quick-btn" aria-label="Add {{ product.title }} to cart">{% render 'snippets/icon', icon: 'plus' %}<span>Add</span></button>
      </form>
    {% else %}
      <div class="card__quick"><a class="card__quick-btn" href="{{ product.url }}" aria-label="Choose options for {{ product.title }}">{% render 'snippets/icon', icon: 'plus' %}<span>Options</span></a></div>
    {% endif %}
  {% endif %}
  <div class="card__body">
    {% if settings.card_show_brand and product.brand %}<span class="card__brand">{{ product.brand }}</span>{% endif %}
    <h3 class="card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <p class="price">
      {% if product.price_varies %}<span class="price__from">From</span>{% endif %}
      {% if pv.comparePrice and pv.comparePrice > pv.price %}
        <span class="price__now price__now--sale">{{ pv.price | money }}</span>
        <s class="price__was">{{ pv.comparePrice | money }}</s>
      {% else %}
        <span class="price__now">{{ pv.price | money }}</span>
      {% endif %}
    </p>
  </div>
</article>
