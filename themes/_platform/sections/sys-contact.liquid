{% comment %}
  The Contact page (/contact): the store's contact details and a form.
  A message lands in the seller's Customers ▸ Queries (and their email);
  the seller answers by email. The details and wording are this section's
  settings in the theme editor.
{% endcomment %}
{% assign s = section.settings %}
{% assign heading = s.heading | default: 'Contact us' %}
<div class="sys">
  <section class="sys-section">
    <div class="sys-container">
      {% unless s.hide_breadcrumbs %}
        <ol class="sys-crumbs" aria-label="Breadcrumb">
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li aria-current="page">{{ heading }}</li>
        </ol>
      {% endunless %}
      <div class="sys-contact{% if s.layout == 'stacked' %} sys-contact--stacked{% endif %}">
        <div class="sys-contact__info">
          <h1 class="sys-h1">{{ heading }}</h1>
          {% if s.intro != blank %}<p class="sys-contact__intro">{{ s.intro | newline_to_br }}</p>{% endif %}
          <dl class="sys-contact__list">
            {% if s.show_email and shop.support_email %}
              <div><dt class="sys-label">Email</dt><dd><a class="sys-link" href="mailto:{{ shop.support_email }}">{{ shop.support_email }}</a></dd></div>
            {% endif %}
            {% if s.show_phone and shop.support_phone %}
              <div><dt class="sys-label">Phone</dt><dd><a class="sys-link" href="tel:{{ shop.support_phone | remove: ' ' }}">{{ shop.support_phone }}</a></dd></div>
            {% endif %}
            {% if s.whatsapp != blank %}
              {% assign wa = s.whatsapp | remove: ' ' | remove: '+' | remove: '-' %}
              <div><dt class="sys-label">WhatsApp</dt><dd><a class="sys-link" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">{{ s.whatsapp }}</a></dd></div>
            {% endif %}
            {% if s.address != blank %}<div><dt class="sys-label">Address</dt><dd>{{ s.address | newline_to_br }}</dd></div>{% endif %}
            {% if s.hours != blank %}<div><dt class="sys-label">Hours</dt><dd>{{ s.hours | newline_to_br }}</dd></div>{% endif %}
          </dl>
          {% if s.details != blank %}<p class="sys-contact__more">{{ s.details | newline_to_br }}</p>{% endif %}
        </div>

        <div class="sys-card sys-contact__form" id="contact-form">
          <h2 class="sys-h3">{{ s.form_heading | default: 'Send us a message' }}</h2>
          {% if notice %}<p class="sys-alert sys-alert--success" role="status">{{ notice }}</p>{% endif %}
          {% if form_error %}<p class="sys-alert sys-alert--error" role="alert">{{ form_error }}</p>{% endif %}
          <form method="post" action="{{ routes.contact_url }}" class="sys-stack" data-sys-once>
            <div class="sys-fields sys-fields--2">
              <label class="sys-field"><span class="sys-label">Name</span><input class="sys-input" name="name" autocomplete="name" required maxlength="80" value="{{ customer.name }}"></label>
              <label class="sys-field"><span class="sys-label">Email</span><input class="sys-input" type="email" name="email" autocomplete="email" required maxlength="200" value="{{ customer.email }}"></label>
            </div>
            {% if s.show_phone_field %}
              <label class="sys-field"><span class="sys-label">Phone{% unless s.require_phone %} <span class="sys-muted">(optional)</span>{% endunless %}</span><input class="sys-input" type="tel" name="phone" autocomplete="tel" inputmode="tel" maxlength="24"{% if s.require_phone %} required{% endif %} value="{{ customer.phone }}"></label>
            {% endif %}
            <label class="sys-field"><span class="sys-label">Message</span><textarea class="sys-textarea" name="message" rows="6" required minlength="2" maxlength="5000" placeholder="{{ s.placeholder | default: 'How can we help?' | escape }}"></textarea></label>
            <div class="sys-visually-hidden" aria-hidden="true"><label>Leave empty <input name="website" tabindex="-1" autocomplete="off"></label></div>
            <button type="submit" class="sys-btn sys-btn--block sys-btn--lg" data-busy-label="Sending…">{{ s.button_label | default: 'Send message' }}</button>
            {% if s.note != blank %}<p class="sys-small sys-muted" style="margin:0;text-align:center">{{ s.note }}</p>{% endif %}
          </form>
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Contact page",
  "locked": true,
  "templates": ["contact"],
  "settings": [
    { "type": "paragraph", "content": "Messages arrive in Customers ▸ Queries and in your email. You answer by email." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact us" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Questions about an order, a product or anything else? Write to us and we'll get back to you within a day." },
    { "type": "header", "content": "Your details" },
    { "type": "checkbox", "id": "show_email", "label": "Show your support email", "info": "Settings ▸ Store details", "default": true },
    { "type": "checkbox", "id": "show_phone", "label": "Show your support phone", "info": "Settings ▸ Store details", "default": true },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp number", "info": "With country code, e.g. +91 98765 43210" },
    { "type": "textarea", "id": "address", "label": "Address" },
    { "type": "textarea", "id": "hours", "label": "Opening hours", "default": "Mon – Sat, 10 am – 7 pm" },
    { "type": "textarea", "id": "details", "label": "More details", "info": "Anything else — GST number, a landmark, how fast you reply." },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send us a message" },
    { "type": "checkbox", "id": "show_phone_field", "label": "Ask for a phone number", "default": true },
    { "type": "checkbox", "id": "require_phone", "label": "Phone number is required", "default": false },
    { "type": "text", "id": "placeholder", "label": "Message placeholder", "default": "How can we help?" },
    { "type": "text", "id": "button_label", "label": "Button text", "default": "Send message" },
    { "type": "text", "id": "note", "label": "Text under the button", "default": "We'll reply to your email." },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "side", "options": [
      { "value": "side", "label": "Details beside the form" },
      { "value": "stacked", "label": "Details above the form" }
    ] },
    { "type": "checkbox", "id": "hide_breadcrumbs", "label": "Hide breadcrumbs", "default": false }
  ]
}
{% endschema %}
