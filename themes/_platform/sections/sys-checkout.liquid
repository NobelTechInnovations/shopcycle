{% comment %}
  Checkout — rendered inside the platform's distraction-free checkout
  layout (layout/sys-checkout.liquid), not the theme's. One form, one
  submit; system.js stops a double click from placing two orders.
  Marketing consent is an unticked box, as India's DPDP Act expects.
{% endcomment %}
{% capture summary_items %}
  <ul class="sys-items">
    {% for item in cart.items %}
      <li class="sys-item">
        <span class="sys-item__media">
          {% if item.image %}<img src="{{ item.image }}" alt="" width="128" height="128">{% endif %}
          <span class="sys-item__qty">{{ item.quantity }}</span>
        </span>
        <span>{{ item.title }}</span>
        <span class="sys-num">{{ item.lineTotal | money }}</span>
      </li>
    {% endfor %}
  </ul>
  <div class="sys-stack" style="gap:10px;margin-top:22px">
    <div class="sys-sumrow"><span>Subtotal</span><span class="sys-num">{{ cart.subtotal | money }}</span></div>
    {% if cart.discount and cart.discount.amount > 0 %}
      <div class="sys-sumrow sys-sumrow--saving"><span>Discount ({{ cart.discount.code }})</span><span class="sys-num">−{{ cart.discount.amount | money }}</span></div>
    {% endif %}
    <div class="sys-sumrow"><span>Delivery</span><span class="sys-num">{% if cart.shipping %}{% if cart.shipping.amount > 0 %}{{ cart.shipping.amount | money }}{% else %}Free{% endif %}{% else %}Free{% endif %}</span></div>
    {% if cart.tax %}<div class="sys-sumrow"><span>{{ cart.tax.name }}</span><span class="sys-num">{{ cart.tax.amount | money }}</span></div>{% endif %}
    <div class="sys-sumrow sys-sumrow--total"><span>Total</span><span class="sys-num">{{ cart.total | money }}</span></div>
  </div>
{% endcapture %}

{% if cart.items.size > 0 %}
  <details class="sys-mobile-summary">
    <summary>
      <span class="sys-row" style="gap:8px">{% render 'snippets/sys-icon', icon: 'bag' %} Show order summary {% render 'snippets/sys-icon', icon: 'chevron-down' %}</span>
      <strong class="sys-num">{{ cart.total | money }}</strong>
    </summary>
    <div class="sys-mobile-summary__body">{{ summary_items }}</div>
  </details>

  <div class="sys-checkout-wrap">
    <div class="sys-container">
      <div class="sys-checkout">
        <form method="post" action="{{ routes.checkout_url }}" class="sys-checkout__main" data-sys-once>
          {% if checkout_error %}<p class="sys-alert sys-alert--error" role="alert" style="margin:0">{{ checkout_error }}</p>{% endif %}

          <div class="sys-step">
            <div class="sys-step__head">
              <h2>Contact</h2>
              {% if customer %}
                <span class="sys-small sys-muted">Signed in as {{ customer.email }}</span>
              {% else %}
                <a class="sys-link sys-small" href="{{ routes.account_login_url }}?return_to=checkout">Sign in for faster checkout</a>
              {% endif %}
            </div>
            <div class="sys-fields sys-fields--2">
              <label class="sys-field">
                <span class="sys-label">Email</span>
                <input class="sys-input" type="email" name="email" required autocomplete="email" value="{{ customer.email }}" placeholder="you@example.com">
              </label>
              <label class="sys-field">
                <span class="sys-label">Mobile number</span>
                <input class="sys-input" type="tel" name="phone" required autocomplete="tel" inputmode="tel" value="{{ customer.phone }}" placeholder="10-digit mobile number">
              </label>
            </div>
            <label class="sys-check">
              <input type="checkbox" name="acceptsMarketing" value="true">
              <span>Email me news and offers from {{ shop.name }}. You can unsubscribe any time.</span>
            </label>
          </div>

          <div class="sys-step">
            <div class="sys-step__head"><h2>Delivery</h2></div>
            <div class="sys-fields">
              <label class="sys-field">
                <span class="sys-label">Full name</span>
                <input class="sys-input" type="text" name="shippingName" required autocomplete="name" value="{{ customer.name }}">
              </label>
              <label class="sys-field">
                <span class="sys-label">Address</span>
                <input class="sys-input" type="text" name="shippingAddress1" required autocomplete="address-line1" value="{{ customer.address1 }}" placeholder="House number, street, area">
              </label>
              <label class="sys-field">
                <span class="sys-label">Apartment, landmark <span class="sys-muted" style="font-weight:400">(optional)</span></span>
                <input class="sys-input" type="text" name="shippingAddress2" autocomplete="address-line2" value="{{ customer.address2 }}">
              </label>
              <div class="sys-fields sys-fields--3">
                <label class="sys-field">
                  <span class="sys-label">City</span>
                  <input class="sys-input" type="text" name="shippingCity" required autocomplete="address-level2" value="{{ customer.city }}">
                </label>
                <label class="sys-field">
                  <span class="sys-label">State</span>
                  <input class="sys-input" type="text" name="shippingProvince" required autocomplete="address-level1" list="sys-states" value="{{ customer.province }}">
                </label>
                <label class="sys-field">
                  <span class="sys-label">PIN code</span>
                  <input class="sys-input" type="text" name="shippingZip" required autocomplete="postal-code" inputmode="numeric" maxlength="10" value="{{ customer.zip }}">
                </label>
              </div>
              <label class="sys-field">
                <span class="sys-label">Country</span>
                <select class="sys-select" name="shippingCountry" required autocomplete="country">
                  {% assign selected_country = customer.country | default: 'IN' %}
                  {% for country in checkout_countries %}
                    <option value="{{ country.code }}" {% if country.code == selected_country %}selected{% endif %}>{{ country.name }}</option>
                  {% endfor %}
                </select>
              </label>
              <datalist id="sys-states">
                {% for state in indian_states %}<option value="{{ state }}"></option>{% endfor %}
              </datalist>
            </div>
          </div>

          <div class="sys-step">
            <div class="sys-step__head">
              <h2>Payment</h2>
              <span class="sys-secure">{% render 'snippets/sys-icon', icon: 'lock' %} Secure</span>
            </div>
            <div class="sys-pay" role="radiogroup" aria-label="Payment method">
              {% for method in payment_methods %}
                <label class="sys-pay__opt">
                  <input type="radio" name="paymentMethod" value="{{ method.value }}" {% if forloop.first %}checked{% endif %}>
                  <span class="sys-pay__label">
                    {% if method.value == 'cod' %}
                      <strong>Cash on delivery</strong>
                      <span>Pay by cash or UPI when your order arrives</span>
                    {% else %}
                      <strong>Pay online</strong>
                      <span>UPI, cards, net banking and wallets via Razorpay</span>
                    {% endif %}
                  </span>
                  {% if method.value == 'cod' %}
                    {% render 'snippets/sys-icon', icon: 'cash' %}
                  {% else %}
                    <span class="sys-pay__icons" aria-hidden="true"><span>UPI</span><span>VISA</span><span>RuPay</span></span>
                  {% endif %}
                </label>
              {% endfor %}
            </div>
          </div>

          <button type="submit" class="sys-btn sys-btn--lg sys-btn--block" data-busy-label="Placing your order…">Place order · {{ cart.total | money }}</button>
          <p class="sys-small sys-muted" style="text-align:center">By placing your order you agree to {{ shop.name }}'s terms and privacy policy.</p>
        </form>

        <aside class="sys-checkout__aside" aria-label="Order summary">
          {{ summary_items }}
          <div class="sys-stack" style="gap:8px;margin-top:24px">
            {% if shop.return_days > 0 %}<span class="sys-note">{% render 'snippets/sys-icon', icon: 'return' %} Easy {{ shop.return_days }}-day returns</span>{% endif %}
            <span class="sys-note">{% render 'snippets/sys-icon', icon: 'shield' %} Payments and details are sent over an encrypted connection</span>
          </div>
        </aside>
      </div>
    </div>
  </div>
{% else %}
  <div class="sys-container">
    <div class="sys-empty">
      <span class="sys-empty__icon">{% render 'snippets/sys-icon', icon: 'bag' %}</span>
      <h1 class="sys-h2">Your cart is empty</h1>
      <p>Add something you love, then come back to check out.</p>
      <a class="sys-btn" href="{{ routes.all_products_url }}">Continue shopping</a>
    </div>
  </div>
{% endif %}

{% schema %}
{ "name": "Checkout", "settings": [] }
{% endschema %}
