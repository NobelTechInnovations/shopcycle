{% comment %}
  Checkout — rendered inside the platform's distraction-free checkout
  layout (layout/sys-checkout.liquid), not the theme's. One page, three
  numbered steps (contact, delivery, payment), one submit; system.js stops
  a double click from placing two orders, fills the state in from the PIN
  code and names the chosen way to pay on the button.
  Ways to pay come from payment_options — one per method the store's
  gateways offer (UPI, card, net banking, …) plus cash on delivery; each
  radio's value is "gateway:method" (the storefront splits it).
  Marketing consent is an unticked box, as India's DPDP Act expects.
{% endcomment %}
{% capture summary_items %}
  <ul class="sys-items">
    {% for item in cart.items %}
      <li class="sys-item">
        <span class="sys-item__media">
          {% if item.image %}<img src="{{ item.image }}" alt="" width="128" height="128">{% endif %}
          <span class="sys-item__qty">{{ item.quantity }}</span>
        </span>
        <span>{{ item.title }}</span>
        <span class="sys-num">{{ item.lineTotal | money }}</span>
      </li>
    {% endfor %}
  </ul>
  <div class="sys-stack" style="gap:10px;margin-top:22px">
    <div class="sys-sumrow"><span>Subtotal</span><span class="sys-num">{{ cart.subtotal | money }}</span></div>
    {% if cart.discount and cart.discount.amount > 0 %}
      <div class="sys-sumrow sys-sumrow--saving"><span>Discount ({{ cart.discount.code }})</span><span class="sys-num">−{{ cart.discount.amount | money }}</span></div>
    {% endif %}
    <div class="sys-sumrow"><span>Delivery</span><span class="sys-num">{% if cart.shipping %}{% if cart.shipping.amount > 0 %}{{ cart.shipping.amount | money }}{% else %}<span class="sys-co__free">Free</span>{% endif %}{% else %}<span class="sys-co__free">Free</span>{% endif %}</span></div>
    {% if cart.tax %}<div class="sys-sumrow"><span>{{ cart.tax.name }}</span><span class="sys-num">{{ cart.tax.amount | money }}</span></div>{% endif %}
    <div class="sys-sumrow sys-sumrow--total"><span>Total</span><span class="sys-num">{{ cart.total | money }}</span></div>
    {% if cart.gift_card and cart.gift_card.amount > 0 %}
      <div class="sys-sumrow sys-sumrow--saving"><span>Gift card ••••{{ cart.gift_card.last4 }}</span><span class="sys-num">−{{ cart.gift_card.amount | money }}</span></div>
      <div class="sys-sumrow sys-sumrow--total"><span>To pay</span><span class="sys-num">{{ cart.due | money }}</span></div>
    {% endif %}
  </div>
{% endcapture %}

{% if cart.items.size > 0 %}
  <details class="sys-mobile-summary">
    <summary>
      <span class="sys-row" style="gap:8px">{% render 'snippets/sys-icon', icon: 'bag' %} Order summary · {{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %} {% render 'snippets/sys-icon', icon: 'chevron-down' %}</span>
      <strong class="sys-num">{{ cart.due | money }}</strong>
    </summary>
    <div class="sys-mobile-summary__body">
      {{ summary_items }}
      <div class="sys-stack" style="gap:10px;margin-top:18px">{% render 'snippets/sys-gift-card', back: 'checkout', slot: 'mobile' %}</div>
    </div>
  </details>

  <div class="sys-checkout-wrap">
    <div class="sys-container">
      <div class="sys-checkout">
        <form method="post" action="{{ routes.checkout_url }}" class="sys-checkout__main sys-co" data-sys-once data-sys-checkout>
          {% if checkout_error %}<p class="sys-alert sys-alert--error" role="alert" style="margin:0">{{ checkout_error }}</p>{% endif %}
          {% comment %} Which fields show, and which are required: Settings ▸ Checkout (checkout_fields). {% endcomment %}
          {% assign cf = checkout_fields %}

          <section class="sys-co__step" aria-labelledby="co-contact">
            <header class="sys-co__head">
              <span class="sys-co__num" aria-hidden="true">1</span>
              <h2 id="co-contact">Contact</h2>
              {% if customer %}
                <span class="sys-co__aside">{% render 'snippets/sys-icon', icon: 'user' %} {{ customer.email | default: customer.phone }}</span>
              {% else %}
                <a class="sys-link sys-small sys-co__aside" href="{{ routes.account_login_url }}?return_to=checkout">Have an account? Sign in</a>
              {% endif %}
            </header>
            <div class="sys-fields{% if cf.phone != 'hidden' %} sys-fields--2{% endif %}">
              {% if cf.phone != 'hidden' %}
                <label class="sys-field">
                  <span class="sys-label">Mobile number{% if cf.phone == 'optional' %} <span class="sys-muted" style="font-weight:400">(optional)</span>{% endif %}</span>
                  <span class="sys-co__control">{% render 'snippets/sys-icon', icon: 'phone' %}<input class="sys-input" type="tel" name="phone" {% if cf.phone == 'required' %}required{% endif %} autocomplete="tel" inputmode="tel" value="{{ customer.phone }}" placeholder="10-digit mobile number"></span>
                </label>
              {% endif %}
              <label class="sys-field">
                <span class="sys-label">Email</span>
                <span class="sys-co__control">{% render 'snippets/sys-icon', icon: 'mail' %}<input class="sys-input" type="email" name="email" required autocomplete="email" value="{{ customer.email }}" placeholder="you@example.com"></span>
              </label>
            </div>
            <p class="sys-co__hint">Order updates and your receipt go here — use them to track this order later.</p>
            {% if cf.marketing != 'hidden' %}
              <label class="sys-check">
                <input type="checkbox" name="acceptsMarketing" value="true">
                <span>Email me news and offers from {{ shop.name }}. You can unsubscribe any time.</span>
              </label>
            {% endif %}
          </section>

          <section class="sys-co__step" aria-labelledby="co-delivery">
            <header class="sys-co__head">
              <span class="sys-co__num" aria-hidden="true">2</span>
              <h2 id="co-delivery">Delivery address</h2>
            </header>
            <div class="sys-fields">
              <label class="sys-field">
                <span class="sys-label">Full name</span>
                <span class="sys-co__control">{% render 'snippets/sys-icon', icon: 'user' %}<input class="sys-input" type="text" name="shippingName" required autocomplete="name" value="{{ customer.name }}" placeholder="First and last name"></span>
              </label>
              <div class="sys-fields sys-fields--2">
                <label class="sys-field">
                  <span class="sys-label">PIN code</span>
                  <span class="sys-co__control">{% render 'snippets/sys-icon', icon: 'pin' %}<input class="sys-input" type="text" name="shippingZip" required autocomplete="postal-code" inputmode="numeric" maxlength="10" value="{{ customer.zip }}" placeholder="6-digit PIN" data-sys-pin></span>
                </label>
                <label class="sys-field">
                  <span class="sys-label">City</span>
                  <input class="sys-input" type="text" name="shippingCity" required autocomplete="address-level2" value="{{ customer.city }}">
                </label>
              </div>
              <label class="sys-field">
                <span class="sys-label">House no., building, street, area</span>
                <input class="sys-input" type="text" name="shippingAddress1" required autocomplete="address-line1" value="{{ customer.address1 }}" placeholder="Flat 402, Lotus Residency, MG Road">
              </label>
              {% if cf.address2 != 'hidden' %}
                <label class="sys-field">
                  <span class="sys-label">Landmark{% if cf.address2 == 'optional' %} <span class="sys-muted" style="font-weight:400">(optional)</span>{% endif %}</span>
                  <input class="sys-input" type="text" name="shippingAddress2" {% if cf.address2 == 'required' %}required{% endif %} autocomplete="address-line2" value="{{ customer.address2 }}" placeholder="Near City Hospital">
                </label>
              {% endif %}
              <div class="sys-fields{% if cf.country != 'india' %} sys-fields--2{% endif %}">
                <label class="sys-field">
                  <span class="sys-label">State</span>
                  <input class="sys-input" type="text" name="shippingProvince" required autocomplete="address-level1" list="sys-states" value="{{ customer.province }}" data-sys-state>
                </label>
                {% if cf.country == 'india' %}
                  <input type="hidden" name="shippingCountry" value="IN">
                {% else %}
                  <label class="sys-field">
                    <span class="sys-label">Country</span>
                    <select class="sys-select" name="shippingCountry" required autocomplete="country">
                      {% assign selected_country = customer.country | default: 'IN' %}
                      {% for country in checkout_countries %}
                        <option value="{{ country.code }}" {% if country.code == selected_country %}selected{% endif %}>{{ country.name }}</option>
                      {% endfor %}
                    </select>
                  </label>
                {% endif %}
              </div>
              {% if cf.company != 'hidden' or cf.gstin != 'hidden' %}
                <div class="sys-fields{% if cf.company != 'hidden' and cf.gstin != 'hidden' %} sys-fields--2{% endif %}">
                  {% if cf.company != 'hidden' %}
                    <label class="sys-field">
                      <span class="sys-label">Company name{% if cf.company == 'optional' %} <span class="sys-muted" style="font-weight:400">(optional)</span>{% endif %}</span>
                      <input class="sys-input" type="text" name="company" {% if cf.company == 'required' %}required{% endif %} autocomplete="organization" maxlength="120">
                    </label>
                  {% endif %}
                  {% if cf.gstin != 'hidden' %}
                    <label class="sys-field">
                      <span class="sys-label">GSTIN <span class="sys-muted" style="font-weight:400">(optional — for a GST invoice)</span></span>
                      <input class="sys-input" type="text" name="gstin" maxlength="15" autocapitalize="characters" spellcheck="false" placeholder="27ABCDE1234F1Z5" pattern="[0-9]{2}[A-Za-z]{5}[0-9]{4}[A-Za-z][1-9A-Za-z][Zz][0-9A-Za-z]" title="15 characters, like 27ABCDE1234F1Z5">
                    </label>
                  {% endif %}
                </div>
              {% endif %}
              {% if cf.note != 'hidden' %}
                <label class="sys-field">
                  <span class="sys-label">Order note <span class="sys-muted" style="font-weight:400">(optional)</span></span>
                  <textarea class="sys-input sys-textarea" name="note" rows="2" maxlength="1000" placeholder="Delivery instructions, a gift message…"></textarea>
                </label>
              {% endif %}
              <datalist id="sys-states">
                {% for state in indian_states %}<option value="{{ state }}"></option>{% endfor %}
              </datalist>
            </div>
          </section>

          <section class="sys-co__step" aria-labelledby="co-payment">
            <header class="sys-co__head">
              <span class="sys-co__num" aria-hidden="true">3</span>
              <h2 id="co-payment">Payment</h2>
              <span class="sys-co__aside sys-secure">{% render 'snippets/sys-icon', icon: 'lock' %} Secure</span>
            </header>
            {% capture first_label %}Place order · {{ cart.due | money }}{% endcapture %}
            {% if cart.due <= 0 %}
              <div class="sys-alert sys-alert--success" role="status" style="margin:0">
                {% render 'snippets/sys-icon', icon: 'gift' %} Your gift card covers the whole order — there's nothing more to pay.
              </div>
              <input type="hidden" name="paymentMethod" value="gift_card">
            {% else %}
              {% if cart.gift_card and cart.gift_card.amount > 0 %}
                <p class="sys-small sys-muted" style="margin:0 0 12px">Your gift card pays {{ cart.gift_card.amount | money }}. Choose how to pay the remaining {{ cart.due | money }}.</p>
              {% endif %}
              <div class="sys-co__pays" role="radiogroup" aria-label="Ways to pay">
                {% if payment_options.size == 0 %}
                  <p class="sys-alert sys-alert--error" style="margin:0">This store isn't taking orders online right now — no payment method is set up. Please contact the store.</p>
                {% endif %}
                {% for option in payment_options %}
                  {% capture pay_label %}{% if option.mode == 'cod' %}Place order · {{ cart.due | money }}{% else %}Pay {{ cart.due | money }}{% case option.mode %}{% when 'upi' %} with UPI{% when 'card' %} by card{% when 'netbanking' %} with net banking{% when 'wallet' %} with a wallet{% when 'emi' %} on EMI{% when 'paylater' %} with Pay later{% when 'paypal' %} with PayPal{% endcase %}{% endif %}{% endcapture %}
                  {% if forloop.first %}{% assign first_label = pay_label %}{% endif %}
                  <label class="sys-co__pay">
                    <input type="radio" name="paymentMethod" value="{{ option.value }}:{{ option.mode }}" data-pay-label="{{ pay_label | strip }}" {% if forloop.first %}checked{% endif %}>
                    <span class="sys-co__pay-icon">
                      {% case option.mode %}
                        {% when 'upi' %}<b class="sys-mark sys-mark--upi">UPI</b>
                        {% when 'netbanking' %}{% render 'snippets/sys-icon', icon: 'bank' %}
                        {% when 'wallet' %}{% render 'snippets/sys-icon', icon: 'wallet' %}
                        {% when 'emi' %}{% render 'snippets/sys-icon', icon: 'emi' %}
                        {% when 'paylater' %}{% render 'snippets/sys-icon', icon: 'clock' %}
                        {% when 'cod' %}{% render 'snippets/sys-icon', icon: 'cash' %}
                        {% else %}{% render 'snippets/sys-icon', icon: 'card' %}
                      {% endcase %}
                    </span>
                    <span class="sys-co__pay-text">
                      <strong>{{ option.title }}{% if forloop.first and option.mode == 'upi' %} <em class="sys-co__pick">Fastest</em>{% endif %}</strong>
                      {% if option.subtitle %}<small>{{ option.subtitle }}</small>{% endif %}
                      {% if option.badges.size > 0 or option.testMode %}<span class="sys-co__badges">{% for b in option.badges %}{% render 'snippets/sys-pay-logo', name: b %}{% endfor %}{% if option.testMode %}<i class="sys-co__test">Test mode</i>{% endif %}</span>{% endif %}
                    </span>
                  </label>
                {% endfor %}
              </div>
            {% endif %}
          </section>

          <div class="sys-co__submit">
            <button type="submit" class="sys-btn sys-btn--lg sys-btn--block sys-co__cta" data-busy-label="Placing your order…" data-sys-pay-button>
              {% render 'snippets/sys-icon', icon: 'lock' %} <span data-sys-pay-text>{% if cart.due <= 0 %}Place order{% else %}{{ first_label | strip }}{% endif %}</span>
            </button>
            <p class="sys-co__legal">
              By placing your order you agree to {{ shop.name }}'s
              {% if shop.policies.size > 0 %}{% for policy in shop.policies %}<a href="{{ policy.url }}" target="_blank" rel="noopener">{{ policy.title }}</a>{% unless forloop.last %}, {% endunless %}{% endfor %}{% else %}terms and privacy policy{% endif %}.
            </p>
            <ul class="sys-co__trust" aria-label="Why it's safe">
              <li>{% render 'snippets/sys-icon', icon: 'shield' %} Secure, encrypted payment</li>
              {% if shop.return_days > 0 %}<li>{% render 'snippets/sys-icon', icon: 'return' %} {{ shop.return_days }}-day returns</li>{% endif %}
              <li>{% render 'snippets/sys-icon', icon: 'truck' %} Tracked delivery</li>
            </ul>
          </div>
        </form>

        <aside class="sys-checkout__aside" aria-label="Order summary">
          <h2 class="sys-co__aside-title">Order summary</h2>
          {{ summary_items }}
          <div class="sys-stack" style="gap:10px;margin-top:20px">{% render 'snippets/sys-gift-card', back: 'checkout', slot: 'aside' %}</div>
          <div class="sys-stack" style="gap:8px;margin-top:24px">
            {% if shop.return_days > 0 %}<span class="sys-note">{% render 'snippets/sys-icon', icon: 'return' %} Easy {{ shop.return_days }}-day returns</span>{% endif %}
            <span class="sys-note">{% render 'snippets/sys-icon', icon: 'shield' %} Payments and details are sent over an encrypted connection</span>
          </div>
        </aside>
      </div>
    </div>
  </div>
{% else %}
  <div class="sys-container">
    <div class="sys-empty">
      <span class="sys-empty__icon">{% render 'snippets/sys-icon', icon: 'bag' %}</span>
      <h1 class="sys-h2">Your cart is empty</h1>
      <p>Add something you love, then come back to check out.</p>
      <a class="sys-btn" href="{{ routes.all_products_url }}">Continue shopping</a>
    </div>
  </div>
{% endif %}

{% schema %}
{ "name": "Checkout", "settings": [] }
{% endschema %}
