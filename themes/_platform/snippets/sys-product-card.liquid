{% comment %}
  Product card for platform pages (collection, search, related). Shows
  the second photo on hover, a sale badge computed from compare-at price,
  and "Sold out" when no variant has stock. The + button quick-adds.
{% endcomment %}
{% assign card_variant = product.price_variant | default: product.variants.first %}
<div class="sys-pcard-wrap" data-oy-card>
<a class="sys-pcard" href="{{ product.url }}">
  <div class="sys-pcard__media" data-oy-card-media>
    {% if product.images.size > 0 %}
      <img data-oy-card-img src="{{ product.images[0].url }}" alt="{{ product.images[0].altText | default: product.title }}" loading="lazy" width="800" height="1000">
      {% if product.images.size > 1 %}
        <img src="{{ product.images[1].url }}" alt="" loading="lazy" width="800" height="1000">
      {% endif %}
    {% else %}
      <span class="sys-placeholder">{% render 'snippets/sys-icon', icon: 'photo' %}</span>
    {% endif %}
    <span class="sys-pcard__badges" data-oy-card-badges>
      {% unless product.available %}
        <span class="sys-badge sys-badge--soldout">Sold out</span>
      {% else %}
        {% if product.on_sale %}<span class="sys-badge sys-badge--sale" data-oy-card-badge>{% case settings.card_badge_label %}{% when 'save' %}Save {{ card_variant.comparePrice | minus: card_variant.price | money_without_trailing_zeros }}{% when 'sale' %}Sale{% else %}−{{ product.discount_percent }}%{% endcase %}</span>{% endif %}
      {% endunless %}
    </span>
  </div>
  <div class="sys-pcard__body" data-oy-card-body>
    {% if product.brand %}<span class="sys-pcard__vendor">{{ product.brand }}</span>{% endif %}
    <span class="sys-pcard__title" data-oy-card-title>{{ product.title }}</span>
    {% if show_card_ratings and product.rating.count > 0 %}
      <span class="sys-pcard__rating">{% render 'snippets/sys-stars', rating: product.rating.average %}({{ product.rating.count }})</span>
    {% endif %}
    <span class="sys-price" data-oy-card-price>
      {% if product.rental %}
        {% if product.rental.has_tiers %}<span class="sys-muted sys-small">From</span>{% endif %}
        <span class="sys-price__now" data-oy-card-now>{% if product.rental.has_tiers %}{{ product.rental.from_price | money }}{% else %}{{ product.rental.price_per_day | money }}{% endif %}</span><span class="sys-muted sys-small">/ day</span>
      {% else %}
        {% if product.price_varies %}<span class="sys-muted sys-small">From</span>{% endif %}
        {% render 'snippets/sys-price', variant: card_variant %}
      {% endif %}
    </span>
  </div>
</a>
{% if product.available %}
  {% comment %} Quick add: a picker in the cart drawer (single-variant products go straight in). {% endcomment %}
  <a class="sys-pcard__quick" data-oy-card-quick="corner" data-oy-card-add href="{{ product.url }}" data-oy-quick="{{ product.handle }}" aria-label="Quick add {{ product.title | escape }}">{% render 'snippets/sys-icon', icon: 'plus' %}<span class="sys-pcard__quick-text">Add to cart</span></a>
{% endif %}
</div>
