{% comment %}
  Grocery product card: square photo on a soft tile, the discount and a
  veg / non-veg mark (product tags "veg" or "non-veg"), the pack size
  (the variant's name, e.g. "500 g"), the price and an ADD button that
  puts it straight in the cart (or opens the size picker when it has
  several). Expects `product`; optional `eager` for the first row.
{% endcomment %}
{% assign pv = product.price_variant | default: product.variants.first %}
{% assign diet = '' %}
{% for t in product.tags %}
  {% assign tl = t | downcase | strip %}
  {% if tl == 'veg' or tl == 'vegetarian' or tl == 'pure veg' %}{% assign diet = 'veg' %}{% endif %}
  {% if tl == 'non-veg' or tl == 'nonveg' or tl == 'non veg' or tl == 'egg' %}{% assign diet = 'nonveg' %}{% endif %}
{% endfor %}
<article class="pcard" data-oy-card>
  <a class="pcard__media" data-oy-card-media href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {% if product.images.size > 0 %}
      <img class="pcard__img" data-oy-card-img src="{{ product.images[0].url }}" alt="" {% unless eager %}loading="lazy"{% endunless %} width="600" height="600">
    {% else %}
      {{ 'image' | placeholder_svg: 'pcard__ph' }}
    {% endif %}
    <span class="pcard__badges" data-oy-card-badges>
      {% unless product.available %}
        <span class="tag tag--muted">Out of stock</span>
      {% else %}
        {% if product.on_sale %}<span class="tag tag--accent" data-oy-card-badge>{% case settings.card_badge_label %}{% when 'save' %}Save {{ pv.comparePrice | minus: pv.price | money_without_trailing_zeros }}{% when 'sale' %}Sale{% else %}{{ product.discount_percent }}% OFF{% endcase %}</span>{% endif %}
      {% endunless %}
    </span>
    {% if diet != '' %}<span data-oy-card-mark class="diet diet--{{ diet }}" title="{% if diet == 'veg' %}Vegetarian{% else %}Non-vegetarian{% endif %}"><i></i></span>{% endif %}
  </a>
  <div class="pcard__body" data-oy-card-body>
    {% if settings.card_show_brand and product.brand %}<span class="pcard__brand">{{ product.brand }}</span>{% endif %}
    <h3 class="pcard__title" data-oy-card-title><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {% if pv.title and pv.title != 'Default' and pv.title != 'Default Title' %}<p class="pcard__pack">{{ pv.title }}{% if product.variants.size > 1 %} · {{ product.variants.size }} sizes{% endif %}</p>{% endif %}
    {% if show_card_ratings and product.rating.count > 0 %}
      <span class="card-rating" aria-label="Rated {{ product.rating.average }} out of 5 from {{ product.rating.count }} reviews"><span class="stars" style="--stars: {{ product.rating.average | times: 20 }}%"></span>({{ product.rating.count }})</span>
    {% endif %}
    <div class="pcard__foot" data-oy-card-foot>
      <p class="price" data-oy-card-price>
        {% if product.rental %}
          <span class="price__now" data-oy-card-now>{{ product.rental.price_per_day | money }}</span><span class="price__from"> / day</span>
        {% else %}
          {% if pv.comparePrice and pv.comparePrice > pv.price %}
            <span class="price__now price__now--sale" data-oy-card-now="sale">{{ pv.price | money }}</span>
            <s class="price__was" data-oy-card-was>{{ pv.comparePrice | money }}</s>
          {% else %}
            <span class="price__now" data-oy-card-now>{{ pv.price | money }}</span>
          {% endif %}
        {% endif %}
      </p>
      {% if product.available %}
        {% if product.variants.size == 1 %}
          <form class="pcard__add" data-oy-card-quick="inline" method="post" action="{{ routes.cart_add_url }}" data-product-title="{{ product.title | escape }}">
            <input type="hidden" name="variantId" value="{{ pv.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="add-btn" data-oy-card-add aria-label="Add {{ product.title | escape }} to cart">ADD</button>
          </form>
        {% else %}
          <a class="add-btn" data-oy-card-quick="inline" data-oy-card-add href="{{ product.url }}" data-oy-quick="{{ product.handle }}" aria-label="Choose a size of {{ product.title | escape }}">ADD</a>
        {% endif %}
      {% endif %}
    </div>
  </div>
</article>
