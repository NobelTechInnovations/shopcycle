{% comment %}
  Category circles for a grocery shop — fruits, vegetables, dairy, snacks,
  drinks — in a row that swipes on phones. Each block picks a collection;
  its own photo and colour override the collection's.
{% endcomment %}
<section class="section section--tight{% if section.settings.surface %} section--surface{% endif %}">
  <div class="container">
    {% if section.settings.heading != blank %}
      {% render 'snippets/section-head', eyebrow: section.settings.eyebrow, title: section.settings.heading, align: 'left', link_url: routes.collections_url, link_text: section.settings.link_text %}
    {% endif %}
    <ul class="chips" role="list">
      {% for block in section.blocks %}
        {% assign coll = collections[block.settings.collection] %}
        {% assign img = block.settings.image | default: coll.image %}
        {% if img == blank and coll.products.size > 0 %}{% assign img = coll.products[0].featured_image.url %}{% endif %}
        {% assign name = block.settings.title | default: coll.title | default: 'Category' %}
        <li>
          <a class="chip" href="{% if coll %}{{ coll.url }}{% else %}{{ routes.all_products_url }}{% endif %}">
            <span class="chip__disc" style="--chip-bg: {{ block.settings.color | default: '#EAF5E4' }}">
              {% if img != blank %}<img src="{{ img | image_url }}" alt="" loading="lazy" width="240" height="240">{% else %}{% assign art = 'product-' | append: forloop.index %}{{ art | placeholder_svg }}{% endif %}
            </span>
            <span class="chip__name">{{ name }}</span>
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Category circles",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "link_text", "label": "\"View all\" link text", "default": "See all" },
    { "type": "checkbox", "id": "surface", "label": "Use light background", "default": false }
  ],
  "blocks": [
    { "type": "category", "name": "Category", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "text", "id": "title", "label": "Name (optional)", "default": "" },
      { "type": "image_picker", "id": "image", "label": "Photo (optional)", "info": "A product cut-out on a plain background looks best." },
      { "type": "color", "id": "color", "label": "Circle colour", "default": "#EAF5E4" }
    ] }
  ],
  "default_blocks": [
    { "type": "category", "settings": { "title": "Fruits", "color": "#FFE9D6" } },
    { "type": "category", "settings": { "title": "Vegetables", "color": "#E3F4DA" } },
    { "type": "category", "settings": { "title": "Dairy & eggs", "color": "#E6F0FB" } },
    { "type": "category", "settings": { "title": "Snacks", "color": "#FFF4CC" } },
    { "type": "category", "settings": { "title": "Drinks", "color": "#F3E6FA" } },
    { "type": "category", "settings": { "title": "Sweets", "color": "#FDE3EA" } }
  ],
  "max_blocks": 12
}
{% endschema %}
