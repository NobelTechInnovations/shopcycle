{% comment %}
  Full-bleed hero: a photo (with an optional phone crop), a headline and up
  to two buttons. Without a photo it shows an illustration, so a new store
  still looks finished. The header can sit over it (Header settings).
{% endcomment %}
<section class="hero hero--{{ section.settings.height }} hero--{{ section.settings.position }} hero--{{ section.settings.text_color }}" style="--hero-shade: {{ section.settings.overlay | divided_by: 100.0 }}">
  <div class="hero__media">
    {% if section.settings.image != blank %}
      <picture>
        {% if section.settings.mobile_image != blank %}<source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url }}">{% endif %}
        <img src="{{ section.settings.image | image_url }}" alt="{{ section.settings.image_alt | escape }}" width="2400" height="1350" fetchpriority="high">
      </picture>
    {% else %}
      <div class="hero__ph">{{ 'lifestyle-1' | placeholder_svg }}</div>
    {% endif %}
  </div>
  <div class="container hero__inner">
    <div class="hero__content">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h1 class="display">{{ section.settings.heading }}</h1>{% endif %}
      {% if section.settings.text != blank %}<p class="hero__text">{{ section.settings.text }}</p>{% endif %}
      {% if section.settings.button_label != blank or section.settings.button2_label != blank %}
        <div class="btn-row">
          {% if section.settings.button_label != blank %}<a class="btn {% if section.settings.text_color == 'light' %}btn--light{% endif %}" href="{{ section.settings.button_link | default: routes.all_products_url }}">{{ section.settings.button_label }}</a>{% endif %}
          {% if section.settings.button2_label != blank %}<a class="btn btn--ghost {% if section.settings.text_color == 'light' %}btn--ghost-light{% endif %}" href="{{ section.settings.button2_link | default: routes.all_products_url }}">{{ section.settings.button2_label }}</a>{% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "2400 × 1350 px or larger works best." },
    { "type": "image_picker", "id": "mobile_image", "label": "Phone image (optional)", "info": "A taller crop for small screens." },
    { "type": "text", "id": "image_alt", "label": "Image description", "default": "" },
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "New season" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Made for the everyday" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Essentials designed to last — thoughtfully made and delivered across India." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button2_label", "label": "Second button", "default": "Our story" },
    { "type": "url", "id": "button2_link", "label": "Second button link" },
    { "type": "select", "id": "height", "label": "Height", "default": "medium", "options": [
      { "value": "medium", "label": "Medium" },
      { "value": "large", "label": "Large" },
      { "value": "full", "label": "Full screen" }
    ] },
    { "type": "select", "id": "position", "label": "Text position", "default": "bottom-left", "options": [
      { "value": "bottom-left", "label": "Bottom left" },
      { "value": "center", "label": "Centre" },
      { "value": "middle-left", "label": "Middle left" }
    ] },
    { "type": "select", "id": "text_color", "label": "Text colour", "default": "light", "options": [
      { "value": "light", "label": "Light (for darker photos)" },
      { "value": "dark", "label": "Dark (for lighter photos)" }
    ] },
    { "type": "range", "id": "overlay", "label": "Shade over the photo (%)", "min": 0, "max": 80, "step": 5, "default": 30 }
  ]
}
{% endschema %}
