{% comment %} Why-buy-from-us row: an icon, a title and a line of text each. {% endcomment %}
<section class="section section--tight{% if section.settings.surface %} section--surface{% endif %}">
  <div class="container">
    <ul class="usp" style="--cols: {{ section.blocks.size | at_most: 4 }}">
      {% for block in section.blocks %}
        <li class="usp__item">
          <span class="usp__icon">{% render 'snippets/icon', icon: block.settings.icon %}</span>
          <div>
            <h3 class="usp__title">{{ block.settings.title }}</h3>
            {% if block.settings.text != blank %}<p class="usp__text">{{ block.settings.text }}</p>{% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Features",
  "settings": [
    { "type": "checkbox", "id": "surface", "label": "Use light background", "default": false }
  ],
  "blocks": [
    { "type": "item", "name": "Feature", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
        { "value": "truck", "label": "Delivery" },
        { "value": "cash", "label": "Cash" },
        { "value": "return", "label": "Returns" },
        { "value": "shield", "label": "Secure" },
        { "value": "leaf", "label": "Natural" },
        { "value": "gift", "label": "Gift" },
        { "value": "chat", "label": "Support" },
        { "value": "heart", "label": "Heart" },
        { "value": "sparkle", "label": "Sparkle" }
      ] },
      { "type": "text", "id": "title", "label": "Title", "default": "Free delivery" },
      { "type": "text", "id": "text", "label": "Text", "default": "On orders over ₹999, anywhere in India." }
    ] }
  ],
  "default_blocks": [
    { "type": "item", "settings": { "icon": "truck", "title": "Fast, free delivery", "text": "Free on orders over ₹999, tracked to your door." } },
    { "type": "item", "settings": { "icon": "cash", "title": "Cash on delivery", "text": "Pay when it arrives — cash or UPI." } },
    { "type": "item", "settings": { "icon": "return", "title": "Easy returns", "text": "Changed your mind? Return within 7 days." } },
    { "type": "item", "settings": { "icon": "chat", "title": "Real support", "text": "Talk to a person, not a bot." } }
  ],
  "max_blocks": 4
}
{% endschema %}
