{% comment %} What's inside: items on both sides of a product picture. {% endcomment %}
<section class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="container">
    {% render 'snippets/section-head', eyebrow: section.settings.eyebrow, title: section.settings.heading, subtitle: section.settings.text, align: 'center' %}
    <div class="x-ingr">
      <ul class="x-ingr__col">
        {% for block in section.blocks limit: 3 %}<li><span class="x-ingr__icon">{% render 'snippets/icon', icon: block.settings.icon %}</span><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></li>{% endfor %}
      </ul>
      <div class="x-ingr__media">
        {% if section.settings.image != blank %}<img src="{{ section.settings.image | image_url }}" alt="" width="800" height="1000" loading="lazy">{% else %}{{ 'product-2' | placeholder_svg }}{% endif %}
      </div>
      <ul class="x-ingr__col">
        {% for block in section.blocks offset: 3 limit: 3 %}<li><span class="x-ingr__icon">{% render 'snippets/icon', icon: block.settings.icon %}</span><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></li>{% endfor %}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "What's inside",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "default": "Clean label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's inside" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every ingredient, and why it's there." },
    { "type": "image_picker", "id": "image", "label": "Picture" },
    { "type": "checkbox", "id": "surface", "label": "Use light background", "default": true }
  ],
  "blocks": [
    { "type": "item", "name": "Ingredient", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "leaf", "options": [{ "value": "truck", "label": "Delivery" }, { "value": "cash", "label": "Cash" }, { "value": "return", "label": "Returns" }, { "value": "shield", "label": "Secure" }, { "value": "leaf", "label": "Natural" }, { "value": "star", "label": "Star" }, { "value": "gift", "label": "Gift" }, { "value": "chat", "label": "Support" }, { "value": "heart", "label": "Heart" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "award", "label": "Award" }, { "value": "diamond", "label": "Quality" }, { "value": "check", "label": "Tick" }] },
      { "type": "text", "id": "title", "label": "Name", "default": "Ashwagandha" },
      { "type": "text", "id": "text", "label": "What it does", "default": "Helps the body handle everyday stress." }
    ] }
  ],
  "default_blocks": [
    { "type": "item", "settings": { "icon": "leaf", "title": "Ashwagandha", "text": "Helps the body handle everyday stress." } },
    { "type": "item", "settings": { "icon": "sparkle", "title": "Brahmi", "text": "Traditionally used for focus and memory." } },
    { "type": "item", "settings": { "icon": "heart", "title": "Magnesium", "text": "Supports relaxed muscles and sleep." } },
    { "type": "item", "settings": { "icon": "diamond", "title": "Tulsi", "text": "A calming herb from Indian kitchens." } },
    { "type": "item", "settings": { "icon": "shield", "title": "Vitamin B6", "text": "Helps reduce tiredness." } },
    { "type": "item", "settings": { "icon": "check", "title": "No added sugar", "text": "Sweetened with fruit, nothing artificial." } }
  ],
  "max_blocks": 6
}
{% endschema %}
