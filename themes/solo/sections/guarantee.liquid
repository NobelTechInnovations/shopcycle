{% comment %} A promise band — a badge, a heading, a line and a button. {% endcomment %}
<section class="section section--tight">
  <div class="container">
    <div class="x-guar" style="--x-bg: {{ section.settings.background }}">
      <span class="x-guar__badge">{% render 'snippets/icon', icon: section.settings.icon %}</span>
      <div class="x-guar__copy">
        <h2 class="h2">{{ section.settings.heading }}</h2>
        {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
      </div>
      {% if section.settings.button_label != blank %}<a class="btn" href="{{ section.settings.button_link | default: '#buy' }}">{{ section.settings.button_label }}</a>{% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promise",
  "settings": [
    { "type": "select", "id": "icon", "label": "Badge", "default": "shield", "options": [{ "value": "truck", "label": "Delivery" }, { "value": "cash", "label": "Cash" }, { "value": "return", "label": "Returns" }, { "value": "shield", "label": "Secure" }, { "value": "leaf", "label": "Natural" }, { "value": "star", "label": "Star" }, { "value": "gift", "label": "Gift" }, { "value": "chat", "label": "Support" }, { "value": "heart", "label": "Heart" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "award", "label": "Award" }, { "value": "diamond", "label": "Quality" }, { "value": "check", "label": "Tick" }] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "30-day money-back promise" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Try it for 30 days. If you don't feel the difference, write to us and we'll refund you — no questions asked." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Try it now" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Empty goes back to the product at the top." },
    { "type": "color", "id": "background", "label": "Background", "default": "#E9F0E4" }
  ]
}
{% endschema %}
