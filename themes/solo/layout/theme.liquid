<!doctype html>
<html lang="{{ shop.locale | default: 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_background | default: '#FFFFFF' }}">
  <title>{{ page_title | default: shop.name }}</title>
  {% if platform.fonts_url %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="{{ platform.fonts_url }}">
  {% endif %}
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  {% comment %}
    Theme settings → CSS variables; theme.css only reads these, so Theme
    settings restyle the whole store live. Product, cart, checkout and
    account pages are the platform's own and take the same colours and
    fonts from storefront/platform.js.
  {% endcomment %}
  {% case settings.section_spacing %}
    {% when 'compact' %}{% assign spacing = 56 %}
    {% when 'spacious' %}{% assign spacing = 128 %}
    {% else %}{% assign spacing = 96 %}
  {% endcase %}
  {% case settings.card_image_ratio %}
    {% when 'square' %}{% assign card_ratio = '1 / 1' %}
    {% when 'tall' %}{% assign card_ratio = '2 / 3' %}
    {% else %}{% assign card_ratio = '4 / 5' %}
  {% endcase %}
  {% case settings.heading_tracking %}
    {% when 'normal' %}{% assign tracking = '-0.01em' %}
    {% when 'tighter' %}{% assign tracking = '-0.045em' %}
    {% else %}{% assign tracking = '-0.03em' %}
  {% endcase %}
  <style>
    :root {
      --c-bg: {{ settings.color_background | default: '#FFFFFF' }};
      --c-text: {{ settings.color_text | default: '#0E0E0E' }};
      --c-primary: {{ settings.color_primary | default: '#0E0E0E' }};
      --c-accent: {{ settings.color_accent | default: '#D7F75B' }};
      --c-surface: {{ settings.color_surface | default: '#F3F3EF' }};
      --c-dark: {{ settings.color_dark | default: '#0E0E0E' }};
      --f-heading: '{{ settings.heading_font | default: "Plus Jakarta Sans" }}', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --f-body: '{{ settings.body_font | default: "DM Sans" }}', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --f-heading-weight: {{ settings.heading_weight | default: 700 }};
      --f-heading-case: {{ settings.heading_case | default: 'none' }};
      --f-heading-tracking: {{ tracking }};
      --f-base: {{ settings.base_size | default: 16 }}px;
      --w-container: {{ settings.container_width | default: 1440 }}px;
      --s-section: {{ spacing }}px;
      --r-button: {{ settings.button_radius | default: 4 }}px;
      --r-card: {{ settings.card_radius | default: 4 }}px;
      --card-ratio: {{ card_ratio }};
      --card-align: {{ settings.card_align | default: 'left' }};
    }
  </style>
  {% render 'snippets/installed-apps' %}
</head>
<body class="template-{{ template.name | default: 'index' }}">
  <a class="skip-link" href="#main">Skip to content</a>
  {% section 'announcement-bar' %}
  {% section 'header' %}
  <main id="main" tabindex="-1">
    {{ content_for_layout }}
  </main>
  {% section 'footer' %}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
