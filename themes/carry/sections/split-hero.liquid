{% comment %}
  Two or three photo panels side by side — Women / Men / Kids, or New in /
  Sale. Each whole panel is one link. On phones they stack. Without a
  photo a panel shows an illustration, so a new store still looks right.
{% endcomment %}
<section class="split split--{{ section.settings.height }} split--n{{ section.blocks.size | at_most: 3 }}">
  {% for block in section.blocks limit: 3 %}
    <a class="split__panel split__panel--{{ block.settings.text_color }}" href="{{ block.settings.link | default: routes.all_products_url }}" style="--split-shade: {{ section.settings.overlay | divided_by: 100.0 }}">
      <span class="split__media">
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.heading | escape }}" width="1200" height="1600"{% if forloop.first %} fetchpriority="high"{% else %} loading="lazy"{% endif %}>
        {% else %}
          {% assign n = forloop.index0 | modulo: 2 | plus: 1 %}{% assign art = 'lifestyle-' | append: n %}{{ art | placeholder_svg: 'split__art' }}
        {% endif %}
      </span>
      <span class="split__content">
        {% if block.settings.eyebrow != blank %}<span class="split__eyebrow">{{ block.settings.eyebrow }}</span>{% endif %}
        <span class="split__title">{{ block.settings.heading }}</span>
        {% if block.settings.button_label != blank %}<span class="split__cta">{{ block.settings.button_label }} {% render 'snippets/icon', icon: 'arrow-right', class: 'icon icon--sm' %}</span>{% endif %}
      </span>
    </a>
  {% endfor %}
</section>

{% schema %}
{
  "name": "Split hero",
  "settings": [
    { "type": "select", "id": "height", "label": "Height", "default": "large", "options": [
      { "value": "medium", "label": "Medium" },
      { "value": "large", "label": "Large" },
      { "value": "full", "label": "Full screen" }
    ] },
    { "type": "range", "id": "overlay", "label": "Shade over the photos (%)", "min": 0, "max": 70, "step": 5, "default": 20 }
  ],
  "blocks": [
    { "type": "panel", "name": "Panel", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image", "info": "Portrait, 1200 × 1600 px or larger." },
      { "type": "text", "id": "eyebrow", "label": "Small text", "default": "New season" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Women" },
      { "type": "text", "id": "button_label", "label": "Link text", "default": "Shop now" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "select", "id": "text_color", "label": "Text colour", "default": "light", "options": [
        { "value": "light", "label": "Light (for darker photos)" },
        { "value": "dark", "label": "Dark (for lighter photos)" }
      ] }
    ] }
  ],
  "default_blocks": [
    { "type": "panel", "settings": { "eyebrow": "New season", "heading": "Women", "button_label": "Shop women" } },
    { "type": "panel", "settings": { "eyebrow": "New season", "heading": "Men", "button_label": "Shop men" } }
  ],
  "max_blocks": 3
}
{% endschema %}
